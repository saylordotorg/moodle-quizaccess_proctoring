{
  "enabled": true,
  "name": "PHP Lint on Save",
  "description": "Runs PHP linting on saved PHP files to catch coding standard violations and style issues.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.php"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "php vendor/bin/phplint ${file}",
    "timeout": 60
  }
}