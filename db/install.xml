<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/quiz/accessrule/proctoring/db" VERSION="2026051159"
       COMMENT="XMLDB file for Moodle mod/quiz/accessrule/proctoring"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="quizaccess_proctoring" COMMENT="Stores all the settings for this accessrule">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" NEXT="quizid"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Foreign key related to quiz.id." PREVIOUS="id" NEXT="proctoringrequired"/>
                <FIELD NAME="proctoringrequired" TYPE="int" LENGTH="2" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="If 1 then the quiz require identity validation." PREVIOUS="quizid"
                       NEXT="requireentirescreen"/>
                <FIELD NAME="requireentirescreen" TYPE="int" LENGTH="2" NOTNULL="true" UNSIGNED="false" DEFAULT="-1"
                       SEQUENCE="false" COMMENT="If 1 this quiz requires entire screen share before start; if 0 it does not; if -1 it inherits the site setting."
                       PREVIOUS="proctoringrequired" NEXT="riskreviewmode"/>
                <FIELD NAME="riskreviewmode" TYPE="int" LENGTH="2" NOTNULL="true" UNSIGNED="false" DEFAULT="-1"
                       SEQUENCE="false" COMMENT="If 1 hold high-risk attempts for review; if 0 do not; if -1 inherit the site setting."
                       PREVIOUS="requireentirescreen" NEXT="riskreviewthreshold"/>
                <FIELD NAME="riskreviewthreshold" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="-1"
                       SEQUENCE="false" COMMENT="Risk score threshold for this quiz; -1 inherits the site setting."
                       PREVIOUS="riskreviewmode" NEXT="captchamode"/>
                <FIELD NAME="captchamode" TYPE="int" LENGTH="2" NOTNULL="true" UNSIGNED="false" DEFAULT="-1"
                       SEQUENCE="false" COMMENT="If 1 require CAPTCHA before a new attempt; if 0 do not; if -1 inherit the site setting."
                       PREVIOUS="riskreviewthreshold"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="quizid"/>
                <KEY NAME="quizid" TYPE="foreign-unique" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"
                     PREVIOUS="primary"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_logs" COMMENT="Stores all validations for reporting">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" NEXT="courseid"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Course id." PREVIOUS="id" NEXT="quizid"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Quiz id" PREVIOUS="courseid" NEXT="userid"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0" SEQUENCE="false"
                       COMMENT="User who validate identity" PREVIOUS="quizid" NEXT="profilepicture"/>
                <FIELD NAME="webcampicture" TYPE="text" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Webcam photo used for validation purposes" PREVIOUS="profilepicture" NEXT="status"/>
                <FIELD NAME="status" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="false"
                       COMMENT="Validation process status" PREVIOUS="webcampicture" NEXT="timemodified"/>
                <FIELD NAME="awsscore" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="AWS image match score" PREVIOUS="status" NEXT="awsflag"/>
                <FIELD NAME="awsflag" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="AWS image match score" PREVIOUS="awsscore" NEXT="timemodified"/>
                <FIELD NAME="deletionprogress" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Progress of deletion process" PREVIOUS="awsflag" NEXT="timemodified"/>      
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="false"
                       COMMENT="Validation process date and time" PREVIOUS="status"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="quizid"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_facematch_task" COMMENT="Stores check face recognition task logs">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true"
                       NEXT="refimageurl"/>
                <FIELD NAME="refimageurl" TYPE="text" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Reference image url" PREVIOUS="id" NEXT="targetimageurl"/>
                <FIELD NAME="targetimageurl" TYPE="text" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Target image url" PREVIOUS="refimageurl" NEXT="reportid"/>
                <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Report id" PREVIOUS="targetimageurl" NEXT="timemodified"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="false"
                       COMMENT="Validation process date and time" PREVIOUS="reportid"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="refimageurl"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_fm_warnings" COMMENT="Stores face mismatch warnings">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" NEXT="reportid"/>
                <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Report id"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Course id"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0" SEQUENCE="false"
                       COMMENT="Quiz id"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0" SEQUENCE="false"
                       COMMENT="User id"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="reportid"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_events" COMMENT="Stores suspicious browser activity during proctored quiz attempts">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" NEXT="courseid"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Course id" PREVIOUS="id" NEXT="quizid"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Course module id" PREVIOUS="courseid" NEXT="userid"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="User id" PREVIOUS="quizid" NEXT="attemptid"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Quiz attempt id" PREVIOUS="userid" NEXT="reportid"/>
                <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Initial proctoring log id" PREVIOUS="attemptid" NEXT="eventtype"/>
                <FIELD NAME="eventtype" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT=""
                       SEQUENCE="false" COMMENT="Suspicious event type" PREVIOUS="reportid" NEXT="eventdetail"/>
                <FIELD NAME="eventdetail" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="JSON event details" PREVIOUS="eventtype" NEXT="pagevisibility"/>
                <FIELD NAME="pagevisibility" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT=""
                       SEQUENCE="false" COMMENT="Document visibility state" PREVIOUS="eventdetail" NEXT="currenturl"/>
                <FIELD NAME="currenturl" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="Quiz page URL when the event was logged" PREVIOUS="pagevisibility" NEXT="screenshoturl"/>
                <FIELD NAME="screenshoturl" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="Desktop screenshot captured when the event was logged" PREVIOUS="currenturl"
                       NEXT="timemodified"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Event server time" PREVIOUS="screenshoturl"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="coursequizuser" UNIQUE="false" FIELDS="courseid, quizid, userid"/>
                <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
                <INDEX NAME="reportid" UNIQUE="false" FIELDS="reportid"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_risk_holds" COMMENT="Stores proctoring risk score grade holds awaiting review">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" NEXT="courseid"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Course id" PREVIOUS="id" NEXT="quizid"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Quiz course module id" PREVIOUS="courseid" NEXT="quizinstance"/>
                <FIELD NAME="quizinstance" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Quiz instance id" PREVIOUS="quizid" NEXT="userid"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="User id" PREVIOUS="quizinstance" NEXT="attemptid"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Quiz attempt id" PREVIOUS="userid" NEXT="reportid"/>
                <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Proctoring report id" PREVIOUS="attemptid" NEXT="riskscore"/>
                <FIELD NAME="riskscore" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Risk score that triggered the hold" PREVIOUS="reportid" NEXT="threshold"/>
                <FIELD NAME="threshold" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Risk score threshold at hold time" PREVIOUS="riskscore" NEXT="originalgrade"/>
                <FIELD NAME="originalgrade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="false"
                       SEQUENCE="false" COMMENT="Quiz grade before the hold was applied" PREVIOUS="threshold" NEXT="status"/>
                <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="0 active, 1 released, 2 confirmed violation" PREVIOUS="originalgrade" NEXT="reviewerid"/>
                <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Reviewer user id" PREVIOUS="status" NEXT="timecreated"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Hold creation time" PREVIOUS="reviewerid" NEXT="timemodified"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Last modified time" PREVIOUS="timecreated" NEXT="timereviewed"/>
                <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Review release time" PREVIOUS="timemodified"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="coursequizuser" UNIQUE="false" FIELDS="courseid, quizid, userid"/>
                <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
                <INDEX NAME="reportid" UNIQUE="false" FIELDS="reportid"/>
                <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_ai_reviews" COMMENT="Stores optional AI image reviews for high-risk proctored quiz attempts">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" NEXT="courseid"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Course id" PREVIOUS="id" NEXT="quizid"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Quiz course module id" PREVIOUS="courseid" NEXT="userid"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="User id" PREVIOUS="quizid" NEXT="attemptid"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Quiz attempt id" PREVIOUS="userid" NEXT="reportid"/>
                <FIELD NAME="reportid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Proctoring report id" PREVIOUS="attemptid" NEXT="eventid"/>
                <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Desktop event id for event-level AI reviews" PREVIOUS="reportid" NEXT="reviewtype"/>
                <FIELD NAME="reviewtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="attempt"
                       SEQUENCE="false" COMMENT="AI review scope: attempt or event" PREVIOUS="eventid" NEXT="holdid"/>
                <FIELD NAME="holdid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Risk hold id, if one exists" PREVIOUS="reviewtype" NEXT="riskscore"/>
                <FIELD NAME="riskscore" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Risk score at queue time" PREVIOUS="holdid" NEXT="triggerthreshold"/>
                <FIELD NAME="triggerthreshold" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="AI review trigger threshold" PREVIOUS="riskscore" NEXT="provider"/>
                <FIELD NAME="provider" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT=""
                       SEQUENCE="false" COMMENT="AI review provider" PREVIOUS="triggerthreshold" NEXT="model"/>
                <FIELD NAME="model" TYPE="char" LENGTH="80" NOTNULL="true" DEFAULT=""
                       SEQUENCE="false" COMMENT="AI model used for review" PREVIOUS="provider" NEXT="reviewscore"/>
                <FIELD NAME="reviewscore" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="AI review score from 0 to 100" PREVIOUS="model" NEXT="decision"/>
                <FIELD NAME="decision" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT=""
                       SEQUENCE="false" COMMENT="AI review decision key" PREVIOUS="reviewscore" NEXT="status"/>
                <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" UNSIGNED="false" DEFAULT="0"
                       SEQUENCE="false" COMMENT="0 queued, 1 processing, 2 complete, 3 failed" PREVIOUS="decision" NEXT="summary"/>
                <FIELD NAME="summary" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="AI review summary" PREVIOUS="status" NEXT="evidence"/>
                <FIELD NAME="evidence" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="AI review evidence JSON" PREVIOUS="summary" NEXT="rawresponse"/>
                <FIELD NAME="rawresponse" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="Raw structured AI review response" PREVIOUS="evidence" NEXT="errormessage"/>
                <FIELD NAME="errormessage" TYPE="text" NOTNULL="false" SEQUENCE="false"
                       COMMENT="Last AI review error" PREVIOUS="rawresponse" NEXT="timecreated"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Queue creation time" PREVIOUS="errormessage" NEXT="timemodified"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="Last modified time" PREVIOUS="timecreated" NEXT="timereviewed"/>
                <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0"
                       SEQUENCE="false" COMMENT="AI review completion time" PREVIOUS="timemodified"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="coursequizuser" UNIQUE="false" FIELDS="courseid, quizid, userid"/>
                <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
                <INDEX NAME="reportid" UNIQUE="false" FIELDS="reportid"/>
                <INDEX NAME="eventid" UNIQUE="false" FIELDS="eventid"/>
                <INDEX NAME="reviewtype" UNIQUE="false" FIELDS="reviewtype"/>
                <INDEX NAME="holdid" UNIQUE="false" FIELDS="holdid"/>
                <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_user_images" COMMENT="Each record is a data of specific user">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="user_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="photo_draft_id" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="quizaccess_proctoring_face_images" COMMENT="Each record is a data of specific Images">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="parent_type" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
                       COMMENT="Foreign key for quizaccess_proctoring_logs table or proctoring_user_images table"/>
                <FIELD NAME="parentid" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="faceimage" TYPE="text" NOTNULL="true" UNSIGNED="false" SEQUENCE="false"
                       COMMENT="Face photo used for validation purposes" PREVIOUS="profilepicture" NEXT="status"/>
                <FIELD NAME="facefound" TYPE="char" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

    </TABLES>
</XMLDB>
