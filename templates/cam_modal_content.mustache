{{!
    @template quizaccess_proctoring/proctoring_page
    Example context (json):
    {
        'header' => 'Proctoring Setup',
        'proctoringstatement' => 'Statement regarding proctoring policies.',
        'videonotavailable' => 'Your browser does not support video.',
        'photoalt' => 'Captured Photo for Verification'
    }
}}

<div class="container-fluid px-0 proctoring-webcam-setup">
    <div class="alert alert-info proctoring-webcam-requirement" role="alert">
        {{#header}}
            <div class="proctoring-webcam-requirement-title">{{{header}}}</div>
        {{/header}}
        {{#proctoringstatement}}
            <div class="proctoring-webcam-requirement-text">{{{proctoringstatement}}}</div>
        {{/proctoringstatement}}
    </div>

    <!-- Video and Canvas Section -->
    <div class="row">
        <div class="col">
            <div class="proctoring-webcam-video-shell">
                <video
                    id="video"
                    class="img-fluid bg-dark proctoring-video-modal"
                    autoplay
                    muted
                    playsinline
                    webkit-playsinline>
                    {{#videonotavailable}}
                        {{{videonotavailable}}}
                    {{/videonotavailable}}
                </video>
            </div>
            <canvas id="canvas" class="d-none"></canvas>
            <img 
                id="photo" 
                class="d-none mt-3 img-fluid"
                alt="{{photoalt}}" />
        </div>
    </div>
</div>
