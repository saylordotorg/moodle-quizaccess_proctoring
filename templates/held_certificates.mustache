{{!
    @template quizaccess_proctoring/held_certificates
    Cross-course held-certificate dashboard.
    Example context (json):
    {
        "intro": "Every attempt whose certificate is currently held for review.",
        "hasbacklog": true,
        "backlog": "Awaiting review: 12 (3 Critical, 6 High, 3 lower). Oldest held since 1 January 2026  9:43 AM EST.",
        "hasexpiringsoon": true,
        "expiringsoon": "2 will be released automatically within 48 hours unless reviewed.",
        "truncated": false,
        "truncatednotice": "Showing up to 2000 held certificates.",
        "hasrows": true,
        "rows": [
            {
                "fullname": "John Doe", "userurl": "https://example.com/user",
                "email": "john.doe@example.com", "course": "CS105", "quiz": "Final exam",
                "attemptfinished": "1 January 2026  9:42 AM EST", "heldsince": "1 January 2026  9:43 AM EST",
                "autorelease": "5 days", "canact": true, "releaseurl": "#", "confirmurl": "#",
                "riskscore": 85, "risklevel": "Critical", "riskbadgeclass": "proctoring-risk-badge",
                "holdlabel": "On hold", "holdclass": "proctoring-cert-held",
                "viewurl": "https://example.com/report"
            }
        ],
        "pagingbar": "<nav></nav>",
        "downloadurl": "https://example.com/download"
    }
}}

<div class="proctoring-held-certificates">
    <p class="text-muted">{{intro}}</p>

    {{#hasbacklog}}
    <p class="proctoring-held-backlog">{{backlog}}</p>
    {{/hasbacklog}}
    {{#hasexpiringsoon}}
    <div class="alert alert-warning proctoring-held-expiring" role="alert">{{expiringsoon}}</div>
    {{/hasexpiringsoon}}

    {{#truncated}}
    <div class="alert alert-warning">{{truncatednotice}}</div>
    {{/truncated}}

    {{#hasrows}}
    <p><a class="btn btn-sm btn-secondary" href="{{downloadurl}}">{{#str}}heldcertificates:downloadcsv, quizaccess_proctoring{{/str}}</a></p>
    <div class="table-responsive">
    <table class="table table-striped proctoring-held-certificates-table">
        <thead>
            <tr>
                <th>{{#str}}heldcertificates:colstudent, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colemail, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colcourse, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colquiz, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colattemptfinished, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colheldsince, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colautorelease, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colrisk, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colcertificate, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}heldcertificates:colactions, quizaccess_proctoring{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <td><a href="{{userurl}}" target="_blank">{{fullname}}</a></td>
                <td>{{email}}</td>
                <td>{{course}}</td>
                <td>{{quiz}}</td>
                <td>{{attemptfinished}}</td>
                <td>{{heldsince}}</td>
                <td>{{autorelease}}</td>
                <td><span class="{{riskbadgeclass}}">{{riskscore}}/100 {{risklevel}}</span></td>
                <td><span class="{{holdclass}}">{{holdlabel}}</span></td>
                <td>
                    <a class="btn btn-sm btn-secondary mb-1" href="{{viewurl}}">{{#str}}heldcertificates:view, quizaccess_proctoring{{/str}}</a>
                    {{#canact}}
                    <a class="btn btn-sm btn-outline-success mb-1" href="{{releaseurl}}">{{#str}}heldcertificates:release, quizaccess_proctoring{{/str}}</a>
                    <a class="btn btn-sm btn-outline-danger mb-1" href="{{confirmurl}}"
                       data-confirmation="modal"
                       data-confirmation-type="delete"
                       data-confirmation-title-str='["overallreport:confirmtitle", "quizaccess_proctoring"]'
                       data-confirmation-content-str='["overallreport:confirmbody", "quizaccess_proctoring"]'
                       data-confirmation-yes-button-str='["heldcertificates:confirm", "quizaccess_proctoring"]'>{{#str}}heldcertificates:confirm, quizaccess_proctoring{{/str}}</a>
                    {{/canact}}
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    </div>
    {{{pagingbar}}}
    {{/hasrows}}

    {{^hasrows}}
    <div class="alert alert-info">{{#str}}heldcertificates:empty, quizaccess_proctoring{{/str}}</div>
    {{/hasrows}}
</div>
