{{!
    @template quizaccess_proctoring/student_report
    Example context (json):
    {
        "issiteadmin": true,
        "redirecturl": "https://example.com/upload-image",
        "firstname": "John",
        "lastname": "Doe",
        "email": "john.doe@example.com",
        "userimageurl": "https://example.com/user-image.png",
        "fcmethod": true,
        "analyzeurl": "https://example.com/analyze",
        "data": [
            {
                "name": "Image 1",
                "image_url": "https://example.com/image1.png",
                "img_id": "img1",
                "border_color": "green",
                "lightbox_data": "lightbox-group-1"
            },
            {
                "name": "Image 2",
                "image_url": "https://example.com/image2.png",
                "img_id": "img2",
                "border_color": "red",
                "lightbox_data": "lightbox-group-1"
            }
        ]
    }
}}

{{! print specific student report  }}

{{! if picture is not uploaded  }}
{{#issiteadmin}}
         <div class="alert alert-warning" role="alert" >
            <h1 class="proctoring-custom-warning-message">{{#str}}userimagenotuploaded, quizaccess_proctoring{{/str}}</h1>
            <a href="{{redirecturl}}" class="proctoring-custom-upload-link">{{#str}}uploadimagehere, quizaccess_proctoring{{/str}}</a>
        </div>
{{/issiteadmin}}

<div class="proctoring-student-report">
<ul class="nav nav-tabs proctoring-report-tabs mt-4" id="proctoring-report-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" id="proctoring-report-summary-tab" data-toggle="tab" data-bs-toggle="tab" href="#proctoring-report-summary" role="tab" aria-controls="proctoring-report-summary" aria-selected="true">{{#str}}reporttab:summary, quizaccess_proctoring{{/str}}</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link" id="proctoring-report-captures-tab" data-toggle="tab" data-bs-toggle="tab" href="#proctoring-report-captures" role="tab" aria-controls="proctoring-report-captures" aria-selected="false">{{#str}}reporttab:captures, quizaccess_proctoring{{/str}}</a>
    </li>
    {{#hasevents}}
    <li class="nav-item" role="presentation">
        <a class="nav-link" id="proctoring-report-activity-tab" data-toggle="tab" data-bs-toggle="tab" href="#proctoring-report-activity" role="tab" aria-controls="proctoring-report-activity" aria-selected="false">{{#str}}reporttab:activity, quizaccess_proctoring{{/str}}</a>
    </li>
    {{/hasevents}}
</ul>

<div class="tab-content proctoring-report-tab-content" id="proctoring-report-tabs-content">
<div class="tab-pane fade show active" id="proctoring-report-summary" role="tabpanel" aria-labelledby="proctoring-report-summary-tab">

{{#riskscore}}
<div class="proctoring-verdict-card">

    {{! Verdict banner: score, level, plain-language headline, review CTA. }}
    <div class="proctoring-verdict-banner">
        <div class="proctoring-verdict-band proctoring-band-{{levelkey}}"></div>
        <div class="proctoring-verdict-body">
            <div class="proctoring-verdict-scorecol">
                <div class="proctoring-verdict-kicker">{{#str}}riskscore:attemptscore, quizaccess_proctoring{{/str}}</div>
                <div class="proctoring-verdict-scorerow">
                    <span class="proctoring-verdict-score">{{score}}</span>
                    <span class="proctoring-verdict-denom">/ 100</span>
                </div>
                <div class="proctoring-verdict-pill proctoring-pill-{{levelkey}}">{{level}}</div>
            </div>
            <div class="proctoring-verdict-textcol">
                <div class="proctoring-verdict-headline">{{verdictheadline}}</div>
                {{#timetakenlabel}}<div class="proctoring-verdict-sub">{{timetakenlabel}}</div>{{/timetakenlabel}}
                {{#thresholdlabel}}<div class="proctoring-verdict-sub">{{thresholdlabel}}</div>{{/thresholdlabel}}
            </div>
            <div class="proctoring-verdict-actioncol">
                {{#ctalabel}}
                <a href="#" class="proctoring-verdict-cta" data-proctoring-tab-jump="{{ctatab}}">{{ctalabel}}</a>
                {{/ctalabel}}
                <div class="proctoring-verdict-meta">{{verdictmeta}}</div>
            </div>
        </div>
    </div>

    {{! Score meter with the configured level boundaries. }}
    <div class="proctoring-verdict-meter">
        <div class="proctoring-meter-track">
            {{#meterzones}}
            <div class="proctoring-meter-zone proctoring-zone-{{zoneclass}}" style="width: {{widthpct}}%;"></div>
            {{/meterzones}}
            <div class="proctoring-meter-marker" style="left: {{markerleft}}%;"></div>
        </div>
        <div class="proctoring-meter-labels">
            {{#meterzones}}
            <span class="proctoring-meter-label proctoring-zonelabel-{{zoneclass}}" style="width: {{widthpct}}%;">{{label}}</span>
            {{/meterzones}}
        </div>
    </div>

    {{#holdstatus}}
    <div class="proctoring-verdict-section">
        <div class="proctoring-risk-hold-banner {{#holdactive}}proctoring-risk-hold-active{{/holdactive}}">
            <strong>{{holdstatus}}</strong>
            {{#canreleasehold}}
                <a class="btn btn-primary btn-sm ml-2" href="{{releaseurl}}">{{#str}}riskreview:releasebutton, quizaccess_proctoring{{/str}}</a>
            {{/canreleasehold}}
            {{#canconfirmhold}}
                <a class="btn btn-danger btn-sm ml-2" href="{{confirmurl}}">{{#str}}riskreview:confirmbutton, quizaccess_proctoring{{/str}}</a>
            {{/canconfirmhold}}
            {{#lockoutuntil}}
                <div class="mt-2">{{lockoutuntil}}</div>
            {{/lockoutuntil}}
            {{#fpholdreleasehint}}
                <div class="mt-2 proctoring-fp-holdhint">{{fpholdreleasehint}}</div>
            {{/fpholdreleasehint}}
        </div>
    </div>
    {{/holdstatus}}

    {{! Flagged findings with capture evidence and the flag timeline. }}
    {{#hasfindings}}
    <div class="proctoring-verdict-section">
        <div class="proctoring-verdict-sectionlabel proctoring-verdict-flaggedlabel">{{needsreviewlabel}}</div>
        {{#hastimeline}}
        <div class="proctoring-verdict-timeline">
            <div class="proctoring-timeline-title">{{#str}}verdict:timeline, quizaccess_proctoring{{/str}}</div>
            <div class="proctoring-timeline-track">
                {{#timelinedots}}
                <div class="proctoring-timeline-dot {{colorclass}}" style="left: {{leftpct}}%;" title="{{label}}"></div>
                {{/timelinedots}}
            </div>
            <div class="proctoring-timeline-ends">
                <span>{{timelinestartlabel}}</span>
                <span>{{timelineendlabel}}</span>
            </div>
            <div class="proctoring-timeline-legend">
                {{#timelinelegend}}
                <div class="proctoring-timeline-legenditem">
                    <span class="proctoring-legend-swatch {{colorclass}}"></span><span>{{label}}</span>
                </div>
                {{/timelinelegend}}
            </div>
        </div>
        {{/hastimeline}}
        {{#findings}}
        <div class="proctoring-finding-card {{#isfalsepositive}}proctoring-finding-dismissed{{/isfalsepositive}}">
            <div class="proctoring-finding-head">
                <span class="proctoring-finding-dot {{colorclass}}"></span>
                <div class="proctoring-finding-title">{{title}}</div>
                <div class="proctoring-finding-badge {{#isfalsepositive}}proctoring-finding-badge-dismissed{{/isfalsepositive}}">{{badge}}</div>
                {{#markurl}}
                <a class="proctoring-finding-fpaction" href="{{markurl}}">{{#str}}findingreview:markbutton, quizaccess_proctoring{{/str}}</a>
                {{/markurl}}
                {{#undourl}}
                <a class="proctoring-finding-fpaction" href="{{undourl}}">{{#str}}findingreview:undobutton, quizaccess_proctoring{{/str}}</a>
                {{/undourl}}
            </div>
            {{#fpbyline}}<div class="proctoring-finding-fpbyline">{{fpbyline}}</div>{{/fpbyline}}
            <div class="proctoring-finding-desc">{{desc}}</div>
            {{#hascaptures}}
            <div class="proctoring-finding-captures">
                {{#captures}}
                <div class="proctoring-finding-capture">
                    <a href="{{url}}" data-lightbox="proc-finding-captures" data-title="{{note}} · {{time}}">
                        <img src="{{url}}" alt="{{note}}">
                    </a>
                    <div class="proctoring-finding-capturemeta">{{time}} <span>· {{note}}</span></div>
                </div>
                {{/captures}}
            </div>
            {{/hascaptures}}
        </div>
        {{/findings}}
    </div>
    {{/hasfindings}}

    {{! Collapsible list of checks that recorded no suspicious activity. }}
    {{#haspassed}}
    <div class="proctoring-verdict-section">
        <details class="proctoring-passed">
            <summary class="proctoring-passed-summary">
                <span class="proctoring-verdict-sectionlabel proctoring-verdict-passedlabel">{{passedlabel}}</span>
                <span class="proctoring-passed-note">{{#str}}verdict:passednote, quizaccess_proctoring{{/str}}</span>
                <span class="proctoring-passed-toggle">{{#str}}verdict:showall, quizaccess_proctoring{{/str}}</span>
            </summary>
            <div class="proctoring-passed-grid">
                {{#passedchecks}}
                <div class="proctoring-passed-item"><span class="proctoring-passed-check">✓</span><span>{{label}}</span></div>
                {{/passedchecks}}
            </div>
        </details>
    </div>
    {{/haspassed}}

    {{#hasnotmonitored}}
    <div class="proctoring-verdict-section proctoring-verdict-notmonitored">
        <span class="proctoring-notmonitored-icon">–</span>
        <div class="proctoring-notmonitored-text">
            <strong>{{#str}}verdict:notmonitored, quizaccess_proctoring{{/str}}</strong>
            {{notmonitoredlist}}. {{#str}}verdict:notmonitorednote, quizaccess_proctoring{{/str}}
        </div>
    </div>
    {{/hasnotmonitored}}

    {{! Raw per-factor scoring table, collapsed for auditing the score arithmetic. }}
    <div class="proctoring-verdict-section">
        <details class="proctoring-scoring-details">
            <summary>{{#str}}verdict:scoringdetails, quizaccess_proctoring{{/str}}</summary>
            <div class="proctoring-risk-factor-container">
                <table class="proctoring-risk-factor-table">
                    <thead>
                        <tr>
                            <th>{{#str}}riskscore:factor, quizaccess_proctoring{{/str}}</th>
                            <th>{{#str}}riskscore:count, quizaccess_proctoring{{/str}}</th>
                            <th>{{#str}}riskscore:points, quizaccess_proctoring{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#factors}}
                        <tr>
                            <td>{{label}}</td>
                            <td>{{count}}</td>
                            <td>{{points}}</td>
                        </tr>
                        {{/factors}}
                    </tbody>
                </table>
            </div>
        </details>
    </div>

</div>
<div class="proctoring-verdict-footnote">{{#str}}verdict:disclaimer, quizaccess_proctoring{{/str}}</div>
{{/riskscore}}

{{#aireview}}
<h3 class="mt-4">{{#str}}aireview:title, quizaccess_proctoring{{/str}}</h3>
<div class="proctoring-ai-review-card {{#isflagged}}proctoring-ai-review-flagged{{/isflagged}}">
    <div class="proctoring-ai-review-header">
        <div>
            <div class="proctoring-ai-review-title">{{statuslabel}}</div>
            <div class="proctoring-ai-review-meta">{{providerlabel}} {{model}}</div>
        </div>
        {{#iscomplete}}
            <div class="proctoring-ai-review-score">{{reviewscore}}/100</div>
        {{/iscomplete}}
    </div>
    {{#iscomplete}}
        <div class="proctoring-ai-review-decision">
            <strong>{{decisionlabel}}</strong>
            <span>{{thresholdlabel}}</span>
        </div>
        {{#isflagged}}
            <div class="alert alert-warning mt-3 mb-0">{{#str}}aireview:flaggednotice, quizaccess_proctoring{{/str}}</div>
        {{/isflagged}}
        {{#summary}}
            <p class="proctoring-ai-review-summary">{{summary}}</p>
        {{/summary}}
        {{#hasevidence}}
            <ul class="proctoring-ai-review-evidence">
                {{#evidenceitems}}
                    <li>{{text}}</li>
                {{/evidenceitems}}
            </ul>
        {{/hasevidence}}
        {{#timereviewed}}
            <div class="proctoring-ai-review-meta">{{#str}}aireview:reviewedat, quizaccess_proctoring{{/str}} {{timereviewed}}</div>
        {{/timereviewed}}
    {{/iscomplete}}
    {{#isqueued}}
        <p class="mb-0">{{#str}}aireview:queuednotice, quizaccess_proctoring{{/str}}</p>
    {{/isqueued}}
    {{#isprocessing}}
        <p class="mb-0">{{#str}}aireview:processingnotice, quizaccess_proctoring{{/str}}</p>
    {{/isprocessing}}
    {{#isfailed}}
        <div class="alert alert-danger mb-0">
            <strong>{{#str}}aireview:failednotice, quizaccess_proctoring{{/str}}</strong>
            {{#errormessage}}<div>{{errormessage}}</div>{{/errormessage}}
        </div>
    {{/isfailed}}
    <div class="proctoring-ai-review-disclaimer">{{#str}}aireview:disclaimer, quizaccess_proctoring{{/str}}</div>
</div>
{{/aireview}}

</div>

<div class="tab-pane fade" id="proctoring-report-captures" role="tabpanel" aria-labelledby="proctoring-report-captures-tab">
<h3>{{#str}}picturesusedreport, quizaccess_proctoring{{/str}}</h3>


{{! user info table  }}


<div class="container-fluid p-0">
    <div class="row no-gutters">
        <!-- Remove any additional margins or padding here -->
        <div class="col-lg-3 col-md-5 ">
            <table class="generaltable generalbox reporttable proctoring-table-style">
            <thead>
                <tr>
                    <th class = "text-center">{{#str}}name, quizaccess_proctoring{{/str}}</th>
                </tr>
            </thead>
                <tbody>
                    <tr>
                        <td class="text-center">
                            <img src="{{userimageurl}}" alt="User Picture" class="img-fluid" id="proctoring-profile-img">
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">{{firstname}} {{lastname}}</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">{{email}}</td>
                    </tr>
                    {{#fcmethod}}
                     <tr>
                        <td class = "text-center">
                            <form method="post" action="{{analyzeurl}}" class="d-inline">
                                <input type="hidden" name="courseid" value="{{analyzecourseid}}">
                                <input type="hidden" name="cmid" value="{{analyzecmid}}">
                                <input type="hidden" name="studentid" value="{{analyzestudentid}}">
                                <input type="hidden" name="reportid" value="{{analyzereportid}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <button type="submit" class="btn btn-primary text-center">
                                    {{#str}}analyzimage, quizaccess_proctoring{{/str}}
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/fcmethod}}
                </tbody>
            </table>
        </div>

    
        <div class=" col-lg-9 col-md-7 ">
            <table class="generaltable generalbox reporttable proctoring-table-style">
            <thead>
                <tr>
                    <th class = "text-center">{{#str}}dateverified, quizaccess_proctoring{{/str}}</th>
                    <th class = "text-center" >{{#str}}webcampicture, quizaccess_proctoring{{/str}}</th>
                    <th class = "text-center">{{#str}}facematchstatus, quizaccess_proctoring{{/str}}</th>
                </tr>
            </thead>
            <tbody id = "proctoring-table-body"  >
                {{#data}}
                <tr class="p-0 m-0">
                    <td class="p-0 m-0">{{name}}</td>
                    <td class="p-0 m-0">
                        {{#image_url}}
                            <a href="{{image_url}}" data-lightbox="proc-images" data-title="{{name}}">
                                <img id="{{img_id}}" class="proctoring-border-color-{{border_color}}"  width="100" 
                                    src="{{image_url}}" alt="{{name}}" data-lightbox="{{lightbox_data}}">
                            </a>
                        {{/image_url}}
                    </td>
                    <td class="text-center align-middle"><span class="{{face_match_status_class}}">{{face_match_status}}</span></td>
                </tr>
                {{/data}}
            </tbody>
            </table>
        </div>
    </div>
</div>
</div>

{{#hasevents}}
<div class="tab-pane fade" id="proctoring-report-activity" role="tabpanel" aria-labelledby="proctoring-report-activity-tab">
<h3>{{#str}}suspiciousactivity, quizaccess_proctoring{{/str}}</h3>
<div class="proctoring-report-table-scroll">
<table class="generaltable generalbox reporttable" id="proctoring-event-table">
    <thead>
        <tr>
            <th>{{#str}}dateverified, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}eventtype, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}eventdetails, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}pagevisibility, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}desktopcapture, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}aireview:shorttitle, quizaccess_proctoring{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#events}}
        <tr>
            <td>{{timemodified}}</td>
            <td>{{eventtype}}</td>
            <td>
                {{#eventdetail}}
                    <details class="proctoring-raw-details">
                        <summary>{{#str}}rawdetails, quizaccess_proctoring{{/str}}</summary>
                        <div class="proctoring-raw-details-body">{{eventdetail}}</div>
                    </details>
                {{/eventdetail}}
                {{^eventdetail}}-{{/eventdetail}}
            </td>
            <td>{{pagevisibility}}</td>
            <td>
                {{#hasscreenshot}}
                    <a href="{{screenshoturl}}" data-lightbox="proc-violation-screens" data-title="{{eventtype}}">
                        <img class="proctoring-event-screenshot" src="{{screenshoturl}}" alt="{{eventtype}}">
                    </a>
                {{/hasscreenshot}}
                {{^hasscreenshot}}-{{/hasscreenshot}}
            </td>
            <td>
                {{#eventaireview}}
                    <span class="{{badgeclass}}">{{compactlabel}}</span>
                    {{#summary}}<div class="small mt-1">{{summary}}</div>{{/summary}}
                    {{#haserror}}<div class="small text-danger mt-1">{{errormessage}}</div>{{/haserror}}
                {{/eventaireview}}
                {{^eventaireview}}
                    {{#hasscreenshot}}<span class="text-muted">{{#str}}aireview:notqueued, quizaccess_proctoring{{/str}}</span>{{/hasscreenshot}}
                    {{^hasscreenshot}}-{{/hasscreenshot}}
                {{/eventaireview}}
            </td>
        </tr>
        {{/events}}
    </tbody>
</table>
</div>
</div>
{{/hasevents}}

</div>
</div>

{{#js}}
require(['jquery'], function($) {
    $('[data-proctoring-tab-jump]').on('click', function(e) {
        e.preventDefault();
        var tab = document.getElementById($(this).attr('data-proctoring-tab-jump'));
        if (tab) {
            tab.click();
        }
    });
});
{{/js}}
