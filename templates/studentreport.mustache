{{! print specific student report  }}

{{! if picture is not uploaded  }}
{{#issiteadmin}}
         <div class="alert alert-warning" role="alert" >
            <h1 class="proctoring-custom-warning-message">{{#str}}userimagenotuploaded, quizaccess_proctoring{{/str}}</h1>
            <a href="{{redirecturl}}" class="proctoring-custom-upload-link">{{#str}}uploadimagehere, quizaccess_proctoring{{/str}}</a>
        </div>
{{/issiteadmin}}

<div class="proctoring-student-report">
<ul class="nav nav-tabs proctoring-report-tabs mt-4" id="proctoring-report-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" id="proctoring-report-summary-tab" data-toggle="tab" data-bs-toggle="tab" href="#proctoring-report-summary" role="tab" aria-controls="proctoring-report-summary" aria-selected="true">{{#str}}reporttab:summary, quizaccess_proctoring{{/str}}</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link" id="proctoring-report-captures-tab" data-toggle="tab" data-bs-toggle="tab" href="#proctoring-report-captures" role="tab" aria-controls="proctoring-report-captures" aria-selected="false">{{#str}}reporttab:captures, quizaccess_proctoring{{/str}}</a>
    </li>
    {{#hasevents}}
    <li class="nav-item" role="presentation">
        <a class="nav-link" id="proctoring-report-activity-tab" data-toggle="tab" data-bs-toggle="tab" href="#proctoring-report-activity" role="tab" aria-controls="proctoring-report-activity" aria-selected="false">{{#str}}reporttab:activity, quizaccess_proctoring{{/str}}</a>
    </li>
    {{/hasevents}}
</ul>

<div class="tab-content proctoring-report-tab-content" id="proctoring-report-tabs-content">
<div class="tab-pane fade show active" id="proctoring-report-summary" role="tabpanel" aria-labelledby="proctoring-report-summary-tab">

{{#riskscore}}
<div class="proctoring-verdict-card">

    {{! Verdict banner: score, level, plain-language headline, review CTA. }}
    <div class="proctoring-verdict-banner">
        <div class="proctoring-verdict-band proctoring-band-{{levelkey}}"></div>
        <div class="proctoring-verdict-body">
            <div class="proctoring-verdict-scorecol">
                <div class="proctoring-verdict-kicker">{{#str}}riskscore:attemptscore, quizaccess_proctoring{{/str}}</div>
                <div class="proctoring-verdict-scorerow">
                    <span class="proctoring-verdict-score">{{score}}</span>
                    <span class="proctoring-verdict-denom">/ 100</span>
                </div>
                <div class="proctoring-verdict-pill proctoring-pill-{{levelkey}}">{{level}}</div>
            </div>
            <div class="proctoring-verdict-textcol">
                <div class="proctoring-verdict-headline">{{verdictheadline}}</div>
                {{#timetakenlabel}}<div class="proctoring-verdict-sub">{{timetakenlabel}}</div>{{/timetakenlabel}}
                {{#thresholdlabel}}<div class="proctoring-verdict-sub">{{thresholdlabel}}</div>{{/thresholdlabel}}
            </div>
            <div class="proctoring-verdict-actioncol">
                {{#ctalabel}}
                <a href="#" class="proctoring-verdict-cta" data-proctoring-tab-jump="{{ctatab}}">{{ctalabel}}</a>
                {{/ctalabel}}
                <div class="proctoring-verdict-meta">{{verdictmeta}}</div>
            </div>
        </div>
    </div>

    {{! Score meter with the configured level boundaries. }}
    <div class="proctoring-verdict-meter">
        <div class="proctoring-meter-track">
            {{#meterzones}}
            <div class="proctoring-meter-zone proctoring-zone-{{zoneclass}}" style="width: {{widthpct}}%;"></div>
            {{/meterzones}}
            <div class="proctoring-meter-marker" style="left: {{markerleft}}%;"></div>
        </div>
        <div class="proctoring-meter-labels">
            {{#meterzones}}
            <span class="proctoring-meter-label proctoring-zonelabel-{{zoneclass}}" style="width: {{widthpct}}%;">{{label}}</span>
            {{/meterzones}}
        </div>
    </div>

    {{#holdstatus}}
    <div class="proctoring-verdict-section">
        <div class="proctoring-risk-hold-banner {{#holdactive}}proctoring-risk-hold-active{{/holdactive}}">
            <strong>{{holdstatus}}</strong>
            {{#canreleasehold}}
                <a class="btn btn-primary btn-sm ml-2" href="{{releaseurl}}">{{#str}}riskreview:releasebutton, quizaccess_proctoring{{/str}}</a>
            {{/canreleasehold}}
            {{#canconfirmhold}}
                <a class="btn btn-danger btn-sm ml-2" href="{{confirmurl}}">{{#str}}riskreview:confirmbutton, quizaccess_proctoring{{/str}}</a>
            {{/canconfirmhold}}
            {{#lockoutuntil}}
                <div class="mt-2">{{lockoutuntil}}</div>
            {{/lockoutuntil}}
            {{#fpholdreleasehint}}
                <div class="mt-2 proctoring-fp-holdhint">{{fpholdreleasehint}}</div>
            {{/fpholdreleasehint}}
        </div>
    </div>
    {{/holdstatus}}

    {{! Flagged findings with capture evidence and the flag timeline. }}
    {{#hasfindings}}
    <div class="proctoring-verdict-section">
        <div class="proctoring-verdict-sectionlabel proctoring-verdict-flaggedlabel">{{needsreviewlabel}}</div>
        {{#hastimeline}}
        <div class="proctoring-verdict-timeline">
            <div class="proctoring-timeline-title">{{#str}}verdict:timeline, quizaccess_proctoring{{/str}}</div>
            <div class="proctoring-timeline-track">
                {{#timelinedots}}
                <div class="proctoring-timeline-dot {{colorclass}}" style="left: {{leftpct}}%;" title="{{label}}"></div>
                {{/timelinedots}}
            </div>
            <div class="proctoring-timeline-ends">
                <span>{{timelinestartlabel}}</span>
                <span>{{timelineendlabel}}</span>
            </div>
            <div class="proctoring-timeline-legend">
                {{#timelinelegend}}
                <div class="proctoring-timeline-legenditem">
                    <span class="proctoring-legend-swatch {{colorclass}}"></span><span>{{label}}</span>
                </div>
                {{/timelinelegend}}
            </div>
        </div>
        {{/hastimeline}}
        {{#findings}}
        <div class="proctoring-finding-card {{#isfalsepositive}}proctoring-finding-dismissed{{/isfalsepositive}}">
            <div class="proctoring-finding-head">
                <span class="proctoring-finding-dot {{colorclass}}"></span>
                <div class="proctoring-finding-title">{{title}}</div>
                <div class="proctoring-finding-badge {{#isfalsepositive}}proctoring-finding-badge-dismissed{{/isfalsepositive}}">{{badge}}</div>
                {{#markurl}}
                <a class="proctoring-finding-fpaction" href="{{markurl}}">{{#str}}findingreview:markbutton, quizaccess_proctoring{{/str}}</a>
                {{/markurl}}
                {{#undourl}}
                <a class="proctoring-finding-fpaction" href="{{undourl}}">{{#str}}findingreview:undobutton, quizaccess_proctoring{{/str}}</a>
                {{/undourl}}
            </div>
            {{#fpbyline}}<div class="proctoring-finding-fpbyline">{{fpbyline}}</div>{{/fpbyline}}
            <div class="proctoring-finding-desc">{{desc}}</div>
            {{#evidence}}<div class="proctoring-finding-evidence">{{evidence}}</div>{{/evidence}}
            {{#hascaptures}}
            <div class="proctoring-finding-captures">
                {{#captures}}
                <div class="proctoring-finding-capture">
                    <a href="{{url}}" data-lightbox="proc-finding-captures" data-title="{{note}} · {{time}}">
                        <img src="{{url}}" alt="{{note}}">
                    </a>
                    <div class="proctoring-finding-capturemeta">{{time}} <span>· {{note}}</span></div>
                </div>
                {{/captures}}
            </div>
            {{/hascaptures}}
        </div>
        {{/findings}}
    </div>
    {{/hasfindings}}

    {{! Collapsible list of checks that recorded no suspicious activity. }}
    {{#haspassed}}
    <div class="proctoring-verdict-section">
        <details class="proctoring-passed">
            <summary class="proctoring-passed-summary">
                <span class="proctoring-verdict-sectionlabel proctoring-verdict-passedlabel">{{passedlabel}}</span>
                <span class="proctoring-passed-note">{{#str}}verdict:passednote, quizaccess_proctoring{{/str}}</span>
                <span class="proctoring-passed-toggle">{{#str}}verdict:showall, quizaccess_proctoring{{/str}}</span>
            </summary>
            <div class="proctoring-passed-grid">
                {{#passedchecks}}
                <div class="proctoring-passed-item"><span class="proctoring-passed-check">✓</span><span>{{label}}</span></div>
                {{/passedchecks}}
            </div>
        </details>
    </div>
    {{/haspassed}}

    {{#hasnotmonitored}}
    <div class="proctoring-verdict-section proctoring-verdict-notmonitored">
        <span class="proctoring-notmonitored-icon">–</span>
        <div class="proctoring-notmonitored-text">
            <strong>{{#str}}verdict:notmonitored, quizaccess_proctoring{{/str}}</strong>
            {{notmonitoredlist}}. {{#str}}verdict:notmonitorednote, quizaccess_proctoring{{/str}}
        </div>
    </div>
    {{/hasnotmonitored}}

    {{! Raw per-factor scoring table, collapsed for auditing the score arithmetic. }}
    <div class="proctoring-verdict-section">
        <details class="proctoring-scoring-details">
            <summary>{{#str}}verdict:scoringdetails, quizaccess_proctoring{{/str}}</summary>
            <div class="proctoring-risk-factor-container">
                <table class="proctoring-risk-factor-table">
                    <thead>
                        <tr>
                            <th>{{#str}}riskscore:factor, quizaccess_proctoring{{/str}}</th>
                            <th>{{#str}}riskscore:count, quizaccess_proctoring{{/str}}</th>
                            <th>{{#str}}riskscore:points, quizaccess_proctoring{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#factors}}
                        <tr>
                            <td>{{label}}</td>
                            <td>{{count}}</td>
                            <td>{{points}}</td>
                        </tr>
                        {{/factors}}
                    </tbody>
                </table>
            </div>
        </details>
    </div>

</div>
<div class="proctoring-verdict-footnote">{{#str}}verdict:disclaimer, quizaccess_proctoring{{/str}}</div>
{{/riskscore}}

{{! Who has looked at this attempt, and what they concluded. Staff-only: nothing here is ever
    rendered on a student-facing page. }}
{{#collaboration}}
{{#canreview}}
<h3 class="mt-4">{{#str}}notes:heading, quizaccess_proctoring{{/str}}</h3>
<div class="proctoring-review-card">
    <div class="proctoring-review-state">
        {{#signoffbyline}}
        <span class="proctoring-review-signedoff">{{signoffbyline}}</span>
        {{/signoffbyline}}
        {{^signoffbyline}}
        <span class="proctoring-review-unreviewed">{{#str}}notes:noreviewyet, quizaccess_proctoring{{/str}}</span>
        {{/signoffbyline}}
        {{#cansignoff}}
        <a class="btn btn-outline-secondary btn-sm" href="{{signoffurl}}">{{#str}}overallreport:signoff, quizaccess_proctoring{{/str}}</a>
        {{/cansignoff}}
        {{#undosignoffurl}}
        <a class="btn btn-link btn-sm" href="{{undosignoffurl}}">{{#str}}overallreport:undosignoff, quizaccess_proctoring{{/str}}</a>
        {{/undosignoffurl}}
    </div>

    {{#hasnotes}}
    <ul class="proctoring-review-notes">
        {{#notes}}
        <li class="proctoring-review-note">
            <div class="proctoring-review-notetext">{{text}}</div>
            <div class="proctoring-review-noteby">
                {{byline}}
                {{#candelete}}
                <a class="proctoring-review-notedelete" href="{{deleteurl}}"
                   data-confirmation="modal"
                   data-confirmation-type="delete"
                   data-confirmation-title-str='["notes:deletetitle", "quizaccess_proctoring"]'
                   data-confirmation-content-str='["notes:deletebody", "quizaccess_proctoring"]'
                   data-confirmation-yes-button-str='["delete", "core"]'>{{#str}}delete{{/str}}</a>
                {{/candelete}}
            </div>
        </li>
        {{/notes}}
    </ul>
    {{/hasnotes}}
    {{^hasnotes}}
    <p class="proctoring-review-nonotes">{{#str}}notes:none, quizaccess_proctoring{{/str}}</p>
    {{/hasnotes}}

    <form method="post" action="{{addurl}}" class="proctoring-review-noteform">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <input type="hidden" name="cmid" value="{{cmid}}">
        <input type="hidden" name="studentid" value="{{studentid}}">
        <input type="hidden" name="reportid" value="{{reportid}}">
        <input type="hidden" name="noteaction" value="add">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <label class="proctoring-review-notelabel" for="proctoring-note-{{reportid}}">{{#str}}notes:addlabel, quizaccess_proctoring{{/str}}</label>
        <textarea id="proctoring-note-{{reportid}}" name="notetext" rows="3"
                  maxlength="{{maxlength}}" class="form-control"
                  placeholder="{{#str}}notes:placeholder, quizaccess_proctoring{{/str}}"></textarea>
        <div class="proctoring-review-noteactions">
            <button type="submit" class="btn btn-primary btn-sm">{{#str}}notes:addbutton, quizaccess_proctoring{{/str}}</button>
            <span class="proctoring-review-notehint">{{#str}}notes:visibility, quizaccess_proctoring{{/str}}</span>
        </div>
    </form>
</div>
{{/canreview}}
{{/collaboration}}

{{#aireview}}
<h3 class="mt-4">{{#str}}aireview:title, quizaccess_proctoring{{/str}}</h3>
<div class="proctoring-ai-review-card {{#isflagged}}proctoring-ai-review-flagged{{/isflagged}}">
    <div class="proctoring-ai-review-header">
        <div>
            <div class="proctoring-ai-review-title">{{statuslabel}}</div>
            <div class="proctoring-ai-review-meta">{{providerlabel}} {{model}}</div>
        </div>
        {{#iscomplete}}
            <div class="proctoring-ai-review-score">{{reviewscore}}/100</div>
        {{/iscomplete}}
    </div>
    {{#iscomplete}}
        <div class="proctoring-ai-review-decision">
            <strong>{{decisionlabel}}</strong>
            <span>{{thresholdlabel}}</span>
        </div>
        {{#isflagged}}
            <div class="alert alert-warning mt-3 mb-0">{{#str}}aireview:flaggednotice, quizaccess_proctoring{{/str}}</div>
        {{/isflagged}}
        {{#summary}}
            <p class="proctoring-ai-review-summary">{{summary}}</p>
        {{/summary}}
        {{#hasevidence}}
            <ul class="proctoring-ai-review-evidence">
                {{#evidenceitems}}
                    <li>{{text}}</li>
                {{/evidenceitems}}
            </ul>
        {{/hasevidence}}
        {{#timereviewed}}
            <div class="proctoring-ai-review-meta">{{#str}}aireview:reviewedat, quizaccess_proctoring{{/str}} {{timereviewed}}</div>
        {{/timereviewed}}
    {{/iscomplete}}
    {{#isqueued}}
        <p class="mb-0">{{#str}}aireview:queuednotice, quizaccess_proctoring{{/str}}</p>
    {{/isqueued}}
    {{#isprocessing}}
        <p class="mb-0">{{#str}}aireview:processingnotice, quizaccess_proctoring{{/str}}</p>
    {{/isprocessing}}
    {{#isfailed}}
        <div class="alert alert-danger mb-0">
            <strong>{{#str}}aireview:failednotice, quizaccess_proctoring{{/str}}</strong>
            {{#errormessage}}<div>{{errormessage}}</div>{{/errormessage}}
        </div>
    {{/isfailed}}
    <div class="proctoring-ai-review-disclaimer">{{#str}}aireview:disclaimer, quizaccess_proctoring{{/str}}</div>
</div>
{{/aireview}}

</div>

<div class="tab-pane fade" id="proctoring-report-captures" role="tabpanel" aria-labelledby="proctoring-report-captures-tab">
{{#captures}}
<div class="proctoring-captures-card">

    {{! The pre-attempt ID check: the document the student presented, the selfie it was compared
        against, and how the name on it was matched to the profile. Captured since 1.2.x and shown
        nowhere until now. }}
    {{#idverification}}
    <div class="proctoring-idv proctoring-idv-{{statuskey}}">
        <div class="proctoring-idv-head">
            <span class="proctoring-idv-title">{{#str}}reportidv:heading, quizaccess_proctoring{{/str}}</span>
            <span class="proctoring-idv-status proctoring-idv-status-{{statuskey}}">{{statuslabel}}</span>
            {{#checkedat}}<span class="proctoring-idv-when">{{#str}}reportidv:checkedat, quizaccess_proctoring{{/str}} {{checkedat}}</span>{{/checkedat}}
        </div>

        {{#isotherattempt}}
        <div class="proctoring-idv-note">{{#str}}reportidv:otherattempt, quizaccess_proctoring{{/str}}</div>
        {{/isotherattempt}}

        {{#hasimages}}
        <div class="proctoring-idv-images">
            {{#images}}
            <figure class="proctoring-idv-image">
                <a href="{{url}}" data-lightbox="proc-idv" data-title="{{label}}">
                    <img src="{{url}}" alt="{{label}}" loading="lazy">
                </a>
                <figcaption>{{label}}</figcaption>
            </figure>
            {{/images}}
        </div>
        {{/hasimages}}
        {{^hasimages}}
        <div class="proctoring-idv-note">{{#str}}reportidv:noimages, quizaccess_proctoring{{/str}}</div>
        {{/hasimages}}

        <dl class="proctoring-idv-facts">
            <div><dt>{{#str}}reportidv:facescore, quizaccess_proctoring{{/str}}</dt><dd>{{facescore}}</dd></div>
            <div><dt>{{#str}}reportidv:namescore, quizaccess_proctoring{{/str}}</dt><dd>{{namescore}}</dd></div>
            {{#extractedname}}<div><dt>{{#str}}reportidv:extractedname, quizaccess_proctoring{{/str}}</dt><dd>{{extractedname}}</dd></div>{{/extractedname}}
            {{#romanizedname}}<div><dt>{{#str}}reportidv:romanizedname, quizaccess_proctoring{{/str}}</dt><dd>{{romanizedname}}</dd></div>{{/romanizedname}}
            {{#profilename}}<div><dt>{{#str}}reportidv:profilename, quizaccess_proctoring{{/str}}</dt><dd>{{profilename}}</dd></div>{{/profilename}}
            {{#matchedprofilename}}<div><dt>{{#str}}reportidv:matchedname, quizaccess_proctoring{{/str}}</dt><dd>{{matchedprofilename}}</dd></div>{{/matchedprofilename}}
        </dl>

        {{#namematchreason}}<div class="proctoring-idv-reason">{{namematchreason}}</div>{{/namematchreason}}
        {{#errormessage}}<div class="proctoring-idv-reason">{{errormessage}}</div>{{/errormessage}}
    </div>
    {{/idverification}}

    {{! Identity verdict band: profile photo vs best capture, plain-language verdict, analyze action. }}
    <div class="proctoring-idband proctoring-idband-{{verdictstate}}">
        <div class="proctoring-idband-photos">
            <div class="proctoring-idband-photo">
                <img src="{{userimageurl}}" alt="{{#str}}reportcaptures:profilephoto, quizaccess_proctoring{{/str}}" id="proctoring-profile-img">
                <div class="proctoring-idband-caption">{{#str}}reportcaptures:profilephoto, quizaccess_proctoring{{/str}}</div>
            </div>
            <div class="proctoring-idband-symbol">{{comparesymbol}}</div>
            <div class="proctoring-idband-photo">
                {{#hasbestcapture}}
                <img src="{{bestcaptureurl}}" class="proctoring-idband-best" alt="{{#str}}reportcaptures:bestcapture, quizaccess_proctoring{{/str}}">
                {{/hasbestcapture}}
                {{^hasbestcapture}}
                <div class="proctoring-idband-placeholder"></div>
                {{/hasbestcapture}}
                <div class="proctoring-idband-caption">{{#str}}reportcaptures:bestcapture, quizaccess_proctoring{{/str}}</div>
            </div>
        </div>
        <div class="proctoring-idband-text">
            <div class="proctoring-idband-headline">{{verdictheadline}}</div>
            <div class="proctoring-idband-desc">{{verdictdesc}}</div>
            <div class="proctoring-idband-student">{{firstname}} {{lastname}} · {{email}}</div>
        </div>
        {{#showanalyze}}
        <div class="proctoring-idband-action">
            <form method="post" action="{{analyzeurl}}">
                <input type="hidden" name="courseid" value="{{analyzecourseid}}">
                <input type="hidden" name="cmid" value="{{analyzecmid}}">
                <input type="hidden" name="studentid" value="{{analyzestudentid}}">
                <input type="hidden" name="reportid" value="{{analyzereportid}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="proctoring-idband-analyze">{{analyzelabel}}</button>
            </form>
            <div class="proctoring-idband-analyzenote">{{analyzenote}}</div>
        </div>
        {{/showanalyze}}
        {{#allanalyzed}}
        <div class="proctoring-idband-action">
            <div class="proctoring-idband-done">✓ {{#str}}reportcaptures:allanalyzed, quizaccess_proctoring{{/str}}</div>
        </div>
        {{/allanalyzed}}
    </div>

    {{! Filter pills and capture cadence. }}
    <div class="proctoring-captures-toolbar">
        {{#showfilters}}
        {{#filters}}
        <button type="button" class="proctoring-capture-filter {{#active}}is-active{{/active}}" data-proctoring-capture-filter="{{key}}">{{label}}</button>
        {{/filters}}
        {{/showfilters}}
        {{#intervalnote}}<div class="proctoring-captures-interval">{{intervalnote}}</div>{{/intervalnote}}
    </div>

    {{! Capture grid with a match-status ring and badge per photo. }}
    <div class="proctoring-captures-grid">
        {{#data}}
        <figure class="proctoring-capture-item" data-proctoring-capture-status="{{statuskey}}">
            <a href="{{image_url}}" class="proctoring-capture-frame proctoring-capture-ring-{{statuskey}}" data-lightbox="proc-images" data-title="{{name}} · {{face_match_status}}">
                <img id="{{img_id}}" src="{{image_url}}" alt="{{name}} · {{face_match_status}}" loading="lazy">
                <span class="proctoring-capture-badge proctoring-capture-badge-{{statuskey}}">{{badgelabel}}</span>
            </a>
            <figcaption class="proctoring-capture-time">{{timeshort}}</figcaption>
        </figure>
        {{/data}}
    </div>
    <div class="proctoring-captures-legend">{{legend}}</div>
</div>
{{/captures}}
</div>

{{#hasevents}}
<div class="tab-pane fade" id="proctoring-report-activity" role="tabpanel" aria-labelledby="proctoring-report-activity-tab">
{{#activity}}
<div class="proctoring-activity-card">

    {{! Plain-language summary of what the raw events amount to, with an attempt timeline. }}
    <div class="proctoring-activity-summary">
        <div class="proctoring-activity-headline">{{headline}}</div>
        {{#rollup}}<div class="proctoring-activity-rollup">{{rollup}}</div>{{/rollup}}
        {{#hastimeline}}
        <div class="proctoring-activity-timeline">
            <div class="proctoring-activity-track">
                {{#timelinespans}}
                <div class="proctoring-activity-span proctoring-activity-span-{{colorclass}}" style="left: {{leftpct}}%; width: {{widthpct}}%;" title="{{label}}"></div>
                {{/timelinespans}}
            </div>
            <div class="proctoring-activity-ends">
                <span>{{timelinestart}}</span>
                <span>{{timelineend}}</span>
            </div>
            <div class="proctoring-activity-legend">
                {{#timelinelegend}}
                <div class="proctoring-activity-legenditem">
                    <span class="proctoring-activity-swatch proctoring-activity-span-{{colorclass}}"></span><span>{{label}}</span>
                </div>
                {{/timelinelegend}}
            </div>
        </div>
        {{/hastimeline}}
    </div>

    {{! One collapsible card per away-from-exam episode or standalone flagged event. }}
    {{#hasepisodes}}
    <div class="proctoring-episodes">
        {{#episodes}}
        <details class="proctoring-episode proctoring-episode-{{accent}}">
            <summary class="proctoring-episode-head">
                <span class="proctoring-episode-time">{{timelabel}}</span>
                <span class="proctoring-episode-dot"></span>
                <span class="proctoring-episode-titles">
                    <span class="proctoring-episode-title">{{title}}</span>
                    {{#sub}}<span class="proctoring-episode-sub">{{sub}}</span>{{/sub}}
                </span>
                {{#evidencepill}}<span class="proctoring-episode-pill">{{evidencepill}}</span>{{/evidencepill}}
                <span class="proctoring-episode-toggle">
                    <span class="proctoring-episode-toggle-open">{{rawlabel}}</span>
                    <span class="proctoring-episode-toggle-close">{{#str}}reportactivity:close, quizaccess_proctoring{{/str}}</span>
                </span>
            </summary>
            <div class="proctoring-episode-body">
                {{#hascaptures}}
                <div class="proctoring-episode-captures">
                    <div class="proctoring-episode-capturelabel">{{#str}}reportactivity:capturelabel, quizaccess_proctoring{{/str}}</div>
                    {{#captures}}
                    <div class="proctoring-episode-capture">
                        <a href="{{url}}" class="proctoring-episode-captureimg" data-lightbox="proc-violation-screens" data-title="{{note}} · {{capturedat}}">
                            <img src="{{url}}" alt="{{note}}" loading="lazy">
                        </a>
                        <div class="proctoring-episode-capturemeta">
                            <div class="proctoring-episode-capturenote">{{note}}. {{capturedat}}</div>
                            {{#aireview}}
                            <div class="proctoring-episode-aireview">
                                <span class="{{badgeclass}}">{{compactlabel}}</span>
                                {{#summary}}<div class="proctoring-episode-aisummary">{{summary}}</div>{{/summary}}
                                {{#haserror}}<div class="proctoring-episode-aisummary text-danger">{{errormessage}}</div>{{/haserror}}
                            </div>
                            {{/aireview}}
                            <a href="{{url}}" data-lightbox="proc-violation-screens" data-title="{{note}} · {{capturedat}}" class="proctoring-episode-fullsize">{{#str}}reportactivity:viewfullsize, quizaccess_proctoring{{/str}}</a>
                        </div>
                    </div>
                    {{/captures}}
                </div>
                {{/hascaptures}}
                <div class="proctoring-episode-rawlabel">{{rawlabel}}</div>
                <div class="proctoring-episode-rawlist">
                    {{#raw}}
                    <div class="proctoring-episode-rawrow">
                        <span class="proctoring-raw-time">{{time}}</span>
                        <span class="proctoring-raw-code">{{code}}</span>
                        <span class="proctoring-raw-extra">{{extra}}</span>
                    </div>
                    {{/raw}}
                </div>
            </div>
        </details>
        {{/episodes}}
    </div>
    {{/hasepisodes}}

    {{! Routine noise (mouse wiggles at the window edge) stays out of the way. }}
    {{#hasroutine}}
    <details class="proctoring-routine">
        <summary class="proctoring-routine-head">
            <span class="proctoring-routine-toggle-open">{{routineshow}}</span>
            <span class="proctoring-routine-toggle-close">{{routinehide}}</span>
            <span class="proctoring-routine-note">{{routinenote}}</span>
        </summary>
        <div class="proctoring-routine-list">
            {{#routine}}
            <div class="proctoring-episode-rawrow">
                <span class="proctoring-raw-time">{{time}}</span>
                <span class="proctoring-raw-code">{{code}}</span>
                <span class="proctoring-raw-extra">{{extra}}</span>
            </div>
            {{/routine}}
        </div>
    </details>
    {{/hasroutine}}
</div>
{{/activity}}
</div>
{{/hasevents}}

</div>
</div>

{{#js}}
require(['jquery'], function($) {
    $('[data-proctoring-tab-jump]').on('click', function(e) {
        e.preventDefault();
        var tab = document.getElementById($(this).attr('data-proctoring-tab-jump'));
        if (tab) {
            tab.click();
        }
    });
    $('[data-proctoring-capture-filter]').on('click', function() {
        var key = $(this).attr('data-proctoring-capture-filter');
        $('[data-proctoring-capture-filter]').removeClass('is-active');
        $(this).addClass('is-active');
        $('[data-proctoring-capture-status]').each(function() {
            $(this).toggleClass(
                'proctoring-capture-hidden',
                key !== 'all' && $(this).attr('data-proctoring-capture-status') !== key
            );
        });
    });
});
{{/js}}
