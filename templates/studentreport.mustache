{{!
    @template quizaccess_proctoring/student_report
    Example context (json):
    {
        "issiteadmin": true,
        "redirecturl": "https://example.com/upload-image",
        "firstname": "John",
        "lastname": "Doe",
        "email": "john.doe@example.com",
        "userimageurl": "https://example.com/user-image.png",
        "fcmethod": true,
        "analyzeurl": "https://example.com/analyze",
        "data": [
            {
                "name": "Image 1",
                "image_url": "https://example.com/image1.png",
                "img_id": "img1",
                "border_color": "green",
                "lightbox_data": "lightbox-group-1"
            },
            {
                "name": "Image 2",
                "image_url": "https://example.com/image2.png",
                "img_id": "img2",
                "border_color": "red",
                "lightbox_data": "lightbox-group-1"
            }
        ]
    }
}}

{{! print specific student report  }}

{{! if picture is not uploaded  }}
{{#issiteadmin}}
         <div class="alert alert-warning" role="alert" >
            <h1 class="proctoring-custom-warning-message">{{#str}}userimagenotuploaded, quizaccess_proctoring{{/str}}</h1>
            <a href="{{redirecturl}}" class="proctoring-custom-upload-link">{{#str}}uploadimagehere, quizaccess_proctoring{{/str}}</a>
        </div>
{{/issiteadmin}}

{{#riskscore}}
<h3 class="mt-4">{{#str}}riskscore, quizaccess_proctoring{{/str}}</h3>
<div class="{{cardclass}}">
    <div>
        <div class="proctoring-risk-title">{{#str}}riskscore:attemptscore, quizaccess_proctoring{{/str}}</div>
        <div class="proctoring-risk-score">{{score}}/100</div>
        {{#thresholdlabel}}
            <div class="proctoring-risk-threshold">{{thresholdlabel}}</div>
        {{/thresholdlabel}}
    </div>
    <div class="proctoring-risk-level">{{level}}</div>
</div>
{{#holdstatus}}
<div class="proctoring-risk-hold-banner {{#holdactive}}proctoring-risk-hold-active{{/holdactive}}">
    <strong>{{holdstatus}}</strong>
    {{#canreleasehold}}
        <a class="btn btn-primary btn-sm ml-2" href="{{releaseurl}}">{{#str}}riskreview:releasebutton, quizaccess_proctoring{{/str}}</a>
    {{/canreleasehold}}
    {{#canconfirmhold}}
        <a class="btn btn-danger btn-sm ml-2" href="{{confirmurl}}">{{#str}}riskreview:confirmbutton, quizaccess_proctoring{{/str}}</a>
    {{/canconfirmhold}}
    {{#lockoutuntil}}
        <div class="mt-2">{{lockoutuntil}}</div>
    {{/lockoutuntil}}
</div>
{{/holdstatus}}
<div class="proctoring-risk-factor-container">
    <table class="proctoring-risk-factor-table">
        <thead>
            <tr>
                <th>{{#str}}riskscore:factor, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}riskscore:count, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}riskscore:points, quizaccess_proctoring{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#factors}}
            <tr>
                <td>{{label}}</td>
                <td>{{count}}</td>
                <td>{{points}}</td>
            </tr>
            {{/factors}}
        </tbody>
    </table>
</div>
{{/riskscore}}

{{#aireview}}
<h3 class="mt-4">{{#str}}aireview:title, quizaccess_proctoring{{/str}}</h3>
<div class="proctoring-ai-review-card {{#isflagged}}proctoring-ai-review-flagged{{/isflagged}}">
    <div class="proctoring-ai-review-header">
        <div>
            <div class="proctoring-ai-review-title">{{statuslabel}}</div>
            <div class="proctoring-ai-review-meta">{{provider}} {{model}}</div>
        </div>
        {{#iscomplete}}
            <div class="proctoring-ai-review-score">{{reviewscore}}/100</div>
        {{/iscomplete}}
    </div>
    {{#iscomplete}}
        <div class="proctoring-ai-review-decision">
            <strong>{{decisionlabel}}</strong>
            <span>{{thresholdlabel}}</span>
        </div>
        {{#isflagged}}
            <div class="alert alert-warning mt-3 mb-0">{{#str}}aireview:flaggednotice, quizaccess_proctoring{{/str}}</div>
        {{/isflagged}}
        {{#summary}}
            <p class="proctoring-ai-review-summary">{{summary}}</p>
        {{/summary}}
        {{#hasevidence}}
            <ul class="proctoring-ai-review-evidence">
                {{#evidenceitems}}
                    <li>{{text}}</li>
                {{/evidenceitems}}
            </ul>
        {{/hasevidence}}
        {{#timereviewed}}
            <div class="proctoring-ai-review-meta">{{#str}}aireview:reviewedat, quizaccess_proctoring{{/str}} {{timereviewed}}</div>
        {{/timereviewed}}
    {{/iscomplete}}
    {{#isqueued}}
        <p class="mb-0">{{#str}}aireview:queuednotice, quizaccess_proctoring{{/str}}</p>
    {{/isqueued}}
    {{#isprocessing}}
        <p class="mb-0">{{#str}}aireview:processingnotice, quizaccess_proctoring{{/str}}</p>
    {{/isprocessing}}
    {{#isfailed}}
        <div class="alert alert-danger mb-0">
            <strong>{{#str}}aireview:failednotice, quizaccess_proctoring{{/str}}</strong>
            {{#errormessage}}<div>{{errormessage}}</div>{{/errormessage}}
        </div>
    {{/isfailed}}
    <div class="proctoring-ai-review-disclaimer">{{#str}}aireview:disclaimer, quizaccess_proctoring{{/str}}</div>
</div>
{{/aireview}}

<h3 class="mt-4">{{#str}}reportoverview, quizaccess_proctoring{{/str}}</h3>
<div class="proctoring-overview-container">
    <table class="proctoring-overview-table">
        <thead>
            <tr>
                <th>{{#str}}reportoverview:overview, quizaccess_proctoring{{/str}}</th>
                <th>{{#str}}reportoverview:status, quizaccess_proctoring{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#overviewrows}}
            <tr>
                <td>{{label}}</td>
                <td><span class="{{statusclass}}">{{status}}</span></td>
            </tr>
            {{/overviewrows}}
        </tbody>
    </table>
</div>

<h3>{{#str}}picturesusedreport, quizaccess_proctoring{{/str}}</h3>


{{! user info table  }}


<div class="container-fluid p-0">
    <div class="row no-gutters">
        <!-- Remove any additional margins or padding here -->
        <div class="col-lg-3 col-md-5 ">
            <table class="generaltable generalbox reporttable" cellpadding="0" cellspacing="0" id="proctoring-table-style">
            <thead>
                <tr>
                    <th class = "text-center">{{#str}}name, quizaccess_proctoring{{/str}}</th>
                </tr>
            </thead>
                <tbody>
                    <tr>
                        <td class="text-center">
                            <img src="{{userimageurl}}" alt="User Picture"class="img-fluid" id="proctoring-profile-img">
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">{{firstname}} {{lastname}}</td>
                    </tr>
                    <tr>
                        <td class="text-center font-weight-bold">{{email}}</td>
                    </tr>
                    {{#fcmethod}}
                     <tr>
                        <td class = "text-center"><a href="{{analyzeurl}}" class="btn btn-primary text-center">{{#str}}analyzimage, quizaccess_proctoring{{/str}}</a></td>
                    </tr>
                    {{/fcmethod}}
                </tbody>
            </table>
        </div>

    
        <div class=" col-lg-9 col-md-7 ">
            <table class="generaltable generalbox reporttable" cellpadding="0" cellspacing="0" id="proctoring-table-style">
            <thead>
                <tr>
                    <th class = "text-center" >{{#str}}webcampicture, quizaccess_proctoring{{/str}}</th>
                </tr>
            </thead>
            <tbody id = "proctoring-table-body"  >
                {{#data}}
                <tr class="p-0 m-0">
                    <td class="p-0 m-0">{{name}}</td>
                    <td class="p-0 m-0">
                        {{#image_url}}
                            <a href="{{image_url}}" data-lightbox="proc-images" data-title="{{name}}">
                                <img id="{{img_id}}" class="proctoring-border-color-{{border_color}}"  width="100" 
                                    src="{{image_url}}" alt="{{name}}" data-lightbox="{{lightbox_data}}">
                            </a>
                        {{/image_url}}
                    </td>
                </tr>
                {{/data}}
            </tbody>
            </table>
        </div>
    </div>
</div>

{{#hasevents}}
<h3 class="mt-4">{{#str}}suspiciousactivity, quizaccess_proctoring{{/str}}</h3>
<table class="generaltable generalbox reporttable" cellpadding="0" cellspacing="0" id="proctoring-event-table">
    <thead>
        <tr>
            <th>{{#str}}dateverified, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}eventtype, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}eventdetails, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}pagevisibility, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}desktopcapture, quizaccess_proctoring{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#events}}
        <tr>
            <td>{{timemodified}}</td>
            <td>{{eventtype}}</td>
            <td>{{eventdetail}}</td>
            <td>{{pagevisibility}}</td>
            <td>
                {{#hasscreenshot}}
                    <a href="{{screenshoturl}}" data-lightbox="proc-violation-screens" data-title="{{eventtype}}">
                        <img class="proctoring-event-screenshot" src="{{screenshoturl}}" alt="{{eventtype}}">
                    </a>
                {{/hasscreenshot}}
                {{^hasscreenshot}}-{{/hasscreenshot}}
            </td>
        </tr>
        {{/events}}
    </tbody>
</table>
{{/hasevents}}

</div>
