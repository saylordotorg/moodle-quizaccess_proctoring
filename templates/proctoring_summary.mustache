{{!
    @template quizaccess_proctoring/proctoring_summary
    Example context (json):
    {
        "summarypagedesc": "Course proctoring summary.",
        "coursesummary": [
            {
                "courseshortname": "COURSE101",
                "coursefullname": "Course 101",
                "url_course_delete": "https://example.com/delete-course",
                "quizsummary": [
                    {
                        "name": "Final Quiz",
                        "camshotcount": 12,
                        "url_quiz_delete": "https://example.com/delete-quiz"
                    }
                ]
            }
        ]
    }
}}

<div class="box generalbox m-b-1 adminerror p-y-1 mb-3">
    {{summarypagedesc}}
</div>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr>
            <th colspan="2">{{#str}}coursenamequizname, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}numberofimages, quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}delete, quizaccess_proctoring{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#coursesummary}}
            <tr class="proctoring-course-row">
                <td colspan="3" class="align-middle">
                    <strong>{{courseshortname}}: {{coursefullname}}</strong>
                </td>
                <td class="align-middle">
                    <form method="post" action="{{url_course_delete}}" class="d-inline">
                        <button class="btn btn-danger" type="submit">
                            <i class="fa fa-trash fa-fw"></i> {{#str}}deleteallcourse, quizaccess_proctoring{{/str}}
                        </button>
                    </form>
                </td>
            </tr>

            {{#quizsummary}}
                <tr class="proctoring-quiz-row">
                    <td></td>
                    <td class="align-middle">{{name}}</td>
                    <td class="align-middle">{{camshotcount}}</td>
                    <td class="align-middle">
                        <form method="post" action="{{url_quiz_delete}}" class="d-inline">
                            <button class="btn btn-danger" type="submit">
                                <i class="fa fa-trash fa-fw"></i> {{#str}}deletequizdata, quizaccess_proctoring{{/str}}
                            </button>
                        </form>
                    </td>
                </tr>
            {{/quizsummary}}
        {{/coursesummary}}
    </tbody>
</table>
