{{!
    @template quizaccess_proctoring/attempt_panel

    Self-contained, read-only proctoring summary for a single quiz attempt. Designed to be
    embedded on the quiz attempt-review page (Requirement 14) so a reviewer sees the risk score,
    the resolved certificate label, the AI image-review status, and a plain-language summary
    alongside the exam attempt, the flagged moments and captures, and Release / Confirm for an
    active hold (CPIT-475).

    Example context (json):
    {
        "heading": "Proctoring summary",
        "certificatelabel": "Certificate",
        "sessionsummary": "This session was flagged for leaving the exam tab (3 times).",
        "hassessionsummary": true,
        "hascertificate": true,
        "certificate": {
            "state": "held",
            "label": "Review required — grade/certificate held",
            "class": "proctoring-cert-held"
        },
        "riskscore": {
            "score": 45,
            "level": "Moderate risk",
            "cardclass": "proctoring-risk-card proctoring-risk-moderate",
            "factors": [
                { "label": "Left the exam tab", "count": 3, "points": 15 }
            ]
        },
        "hasaireview": true,
        "aireview": {
            "statuslabel": "Completed",
            "badgeclass": "badge badge-success",
            "compactlabel": "20/100 Not suspicious",
            "iscomplete": true,
            "isfailed": false
        },
        "hasflaggedmoments": true,
        "flaggedmoments": [{ "time": "10:02 AM", "label": "Left the exam tab" }],
        "moreflaggedmoments": "",
        "hasflaggedcaptures": true,
        "flaggedcaptures": [{ "url": "https://example.com/capture.png", "time": "10:03 AM", "label": "no face" }],
        "moreflaggedcaptures": "and 3 more in the full report",
        "canacthold": true, "releaseurl": "#", "confirmurl": "#",
        "reporturl": "https://example.com/report"
    }
}}

<section class="proctoring-attempt-panel card mt-3 mb-3" aria-label="{{heading}}">
    <div class="card-body">
        <h3 class="proctoring-attempt-panel-heading h5">{{heading}}</h3>

        {{#hassessionsummary}}
        <div class="proctoring-session-summary alert alert-info" role="note">
            <p class="proctoring-session-summary-text mb-0">{{sessionsummary}}</p>
        </div>
        {{/hassessionsummary}}

        {{#coverage}}{{> quizaccess_proctoring/monitoring_coverage}}{{/coverage}}

        {{#riskscore}}
        <div class="{{cardclass}}">
            <div>
                <div class="proctoring-risk-title">{{#str}}riskscore:attemptscore, quizaccess_proctoring{{/str}}</div>
                <div class="proctoring-risk-score">{{score}}/100</div>
            </div>
            <div class="proctoring-risk-level">{{level}}</div>
        </div>
        {{#timetakenlabel}}
        <div class="proctoring-risk-duration">{{timetakenlabel}}</div>
        {{/timetakenlabel}}
        <div class="proctoring-risk-factor-container">
            <table class="proctoring-risk-factor-table">
                <thead>
                    <tr>
                        <th>{{#str}}riskscore:factor, quizaccess_proctoring{{/str}}</th>
                        <th>{{#str}}riskscore:count, quizaccess_proctoring{{/str}}</th>
                        <th>{{#str}}riskscore:points, quizaccess_proctoring{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#factors}}
                    <tr>
                        <td>{{label}}</td>
                        <td>{{count}}</td>
                        <td>{{points}}</td>
                    </tr>
                    {{/factors}}
                </tbody>
            </table>
        </div>
        {{/riskscore}}

        {{#hascertificate}}
        {{#certificate}}
        <div class="proctoring-attempt-panel-certificate mt-3">
            <span class="proctoring-attempt-panel-certificate-label font-weight-bold">{{certificatelabel}}:</span>
            <span class="{{class}}">{{label}}</span>
        </div>
        {{/certificate}}
        {{/hascertificate}}

        {{#hasflaggedmoments}}
        <div class="proctoring-attempt-panel-moments mt-3">
            <h4 class="h6">{{#str}}attemptpanel:flaggedmoments, quizaccess_proctoring{{/str}}</h4>
            <ul class="list-unstyled small mb-0">
                {{#flaggedmoments}}
                <li><span class="text-muted">{{time}}</span> {{label}}</li>
                {{/flaggedmoments}}
            </ul>
            {{#moreflaggedmoments}}<div class="small text-muted">{{moreflaggedmoments}}</div>{{/moreflaggedmoments}}
        </div>
        {{/hasflaggedmoments}}

        {{#hasflaggedcaptures}}
        <div class="proctoring-attempt-panel-captures mt-3">
            <h4 class="h6">{{#str}}attemptpanel:flaggedcaptures, quizaccess_proctoring{{/str}}</h4>
            <div class="d-flex flex-wrap">
                {{#flaggedcaptures}}
                <figure class="mr-2 me-2 mb-2 text-center small">
                    <a href="{{url}}" target="_blank" rel="noopener"><img src="{{url}}" alt="{{label}} {{time}}" width="120" class="img-thumbnail"></a>
                    <figcaption>{{time}} &middot; {{label}}</figcaption>
                </figure>
                {{/flaggedcaptures}}
            </div>
            {{#moreflaggedcaptures}}<div class="small text-muted">{{moreflaggedcaptures}}</div>{{/moreflaggedcaptures}}
        </div>
        {{/hasflaggedcaptures}}

        {{#hasaireview}}
        {{#aireview}}
        <div class="proctoring-attempt-panel-aireview mt-3">
            <h4 class="h6">{{#str}}aireview:title, quizaccess_proctoring{{/str}}</h4>
            <span class="{{badgeclass}}">{{compactlabel}}</span>
            {{#isfailed}}
            <div class="proctoring-ai-toolfailure small mt-1">{{toolfailurenotice}}</div>
            {{/isfailed}}
            {{#iscomplete}}
                {{#summary}}<div class="small mt-1">{{summary}}</div>{{/summary}}
            {{/iscomplete}}
        </div>
        {{/aireview}}
        {{/hasaireview}}

        <div class="proctoring-attempt-panel-actions mt-3">
            {{#canacthold}}
            <a class="btn btn-sm btn-outline-success mr-2 me-2" href="{{releaseurl}}">{{#str}}heldcertificates:release, quizaccess_proctoring{{/str}}</a>
            <a class="btn btn-sm btn-outline-danger mr-2 me-2" href="{{confirmurl}}"
               data-confirmation="modal"
               data-confirmation-type="delete"
               data-confirmation-title-str='["overallreport:confirmtitle", "quizaccess_proctoring"]'
               data-confirmation-content-str='["overallreport:confirmbody", "quizaccess_proctoring"]'
               data-confirmation-yes-button-str='["heldcertificates:confirm", "quizaccess_proctoring"]'>{{#str}}heldcertificates:confirm, quizaccess_proctoring{{/str}}</a>
            {{/canacthold}}
            {{#reporturl}}
            <a class="btn btn-sm btn-secondary" href="{{reporturl}}">{{#str}}attemptpanel:openreport, quizaccess_proctoring{{/str}}</a>
            {{/reporturl}}
        </div>
    </div>
</section>
