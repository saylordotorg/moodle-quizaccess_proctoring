{{!
    @template quizaccess_proctoring/overall_reports
    Site-wide aggregate proctoring report ("Exam integrity review").
    Example context (json):
    {
        "formurl": "https://example.com/overall_reports.php",
        "intro": "Every proctored exam attempt across your courses.",
        "minviolations": 0,
        "courseoptions": [{"value": 0, "label": "All courses", "selected": true}],
        "rangeoptions": [{"value": "7days", "label": "Last 7 days", "selected": true}],
        "sortoptions": [{"value": "violations", "label": "Most violations", "selected": true}],
        "pulse": [{"num": 2, "label": "Waiting for your review", "hint": "Flagged attempts", "url": "#", "iscritical": true, "isactive": true}],
        "views": [{"label": "Needs review (2)", "url": "#", "isactive": true}],
        "countnote": "Showing 2 of 12 attempts",
        "rows": [
            {
                "fullname": "John Doe", "userurl": "#", "course": "CS105", "quiz": "Final exam",
                "lastactivity": "1 Jan 2026, 10:00", "riskscore": 85, "risklevel": "Critical", "levelkey": "critical",
                "signalsummary": "AI tool (2) · Tab switching (5)", "statuslabel": "Needs review", "reviewstate": "needs",
                "isneeds": true, "hassignals": true,
                "signals": [{"factor": "AI tool", "pts": "+30"}],
                "breakdown": [{"factor": "AI tool", "pts": "+30"}],
                "canact": true, "releaseurl": "#", "confirmurl": "#", "viewurl": "#"
            }
        ],
        "hasrows": true, "emptyqueue": false, "pagingbar": "<nav></nav>"
    }
}}

<div class="proctoring-overview">
    <p class="proctoring-overview-intro">{{intro}}</p>

    {{! Filters: course + period + sort + minimum violations. }}
    <form method="get" action="{{formurl}}" class="proctoring-overview-filters">
        <input type="hidden" name="queue" value="{{queue}}">
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filtercourse, quizaccess_proctoring{{/str}}</span>
            <select name="courseid">
                {{#courseoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/courseoptions}}
            </select>
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filterrange, quizaccess_proctoring{{/str}}</span>
            <select name="range">
                {{#rangeoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/rangeoptions}}
            </select>
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filtersort, quizaccess_proctoring{{/str}}</span>
            <select name="sort">
                {{#sortoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/sortoptions}}
            </select>
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filterminviolations, quizaccess_proctoring{{/str}}</span>
            <input type="number" min="0" name="minviolations" value="{{minviolations}}">
        </label>
        <button type="submit" class="btn btn-secondary proctoring-overview-apply">{{#str}}overallreport:apply, quizaccess_proctoring{{/str}}</button>
    </form>

    {{! Pulse cards. }}
    <div class="proctoring-overview-pulse">
        {{#pulse}}
        <a class="proctoring-overview-pulsecard {{#isactive}}is-active{{/isactive}}" href="{{url}}">
            <div class="proctoring-overview-pulsenum {{#iscritical}}is-critical{{/iscritical}}">{{num}}</div>
            <div class="proctoring-overview-pulselabel">{{label}}</div>
            <div class="proctoring-overview-pulsehint">{{hint}}</div>
        </a>
        {{/pulse}}
    </div>

    {{! View pills. }}
    <div class="proctoring-overview-views">
        {{#views}}
        <a class="proctoring-overview-pill {{#isactive}}is-active{{/isactive}}" href="{{url}}">{{label}}</a>
        {{/views}}
        <span class="proctoring-overview-countnote">{{countnote}}</span>
    </div>

    {{#truncated}}<div class="alert alert-warning">{{truncatednotice}}</div>{{/truncated}}

    {{! Attempt cards. }}
    <div class="proctoring-overview-list">
        {{#rows}}
        <details class="proctoring-overview-attempt {{#isneeds}}is-needs{{/isneeds}} {{#isclean}}is-clean{{/isclean}}">
            <summary class="proctoring-overview-attempthead">
                <span class="proctoring-overview-score proctoring-risk-{{levelkey}}">
                    <span class="proctoring-overview-scorenum">{{riskscore}}</span>
                    <span class="proctoring-overview-scoreband">{{risklevel}}</span>
                </span>
                <span class="proctoring-overview-who">
                    <span class="proctoring-overview-wholine">
                        <span class="proctoring-overview-student">{{fullname}}</span>
                        <span class="proctoring-overview-context">{{course}} · {{quiz}}</span>
                    </span>
                    <span class="proctoring-overview-signal">{{signalsummary}}</span>
                </span>
                <span class="proctoring-overview-when">{{lastactivity}}</span>
                <span class="proctoring-overview-status proctoring-overview-status-{{reviewstate}}">{{statuslabel}}</span>
                <span class="proctoring-overview-chev">{{#str}}overallreport:details, quizaccess_proctoring{{/str}}</span>
            </summary>
            <div class="proctoring-overview-detail">
                <div class="proctoring-overview-detailcols">
                    {{#hassignals}}
                    <div class="proctoring-overview-detailcol is-wide">
                        <div class="proctoring-overview-detailhead">{{#str}}overallreport:detected, quizaccess_proctoring{{/str}}</div>
                        <div class="proctoring-overview-signals">
                            {{#signals}}
                            <div class="proctoring-overview-signalrow"><span class="proctoring-overview-signaldot"></span>{{factor}} <span class="proctoring-overview-signalpts">{{pts}}</span></div>
                            {{/signals}}
                        </div>
                    </div>
                    <div class="proctoring-overview-detailcol">
                        <div class="proctoring-overview-detailhead">{{#str}}overallreport:breakdown, quizaccess_proctoring{{/str}}</div>
                        <div class="proctoring-overview-breakdown">
                            {{#breakdown}}
                            <div class="proctoring-overview-breakrow"><span>{{factor}}</span><span class="proctoring-overview-breakpts">{{pts}}</span></div>
                            {{/breakdown}}
                        </div>
                    </div>
                    {{/hassignals}}
                    {{^hassignals}}
                    <div class="proctoring-overview-detailcol is-wide">
                        <div class="proctoring-overview-signalrow"><span class="proctoring-overview-signaldot is-ok"></span>{{#str}}overallreport:nosignals, quizaccess_proctoring{{/str}}</div>
                    </div>
                    {{/hassignals}}
                </div>
                <div class="proctoring-overview-actions">
                    <a class="btn proctoring-overview-primary" href="{{viewurl}}">{{#str}}overallreport:openreport, quizaccess_proctoring{{/str}}</a>
                    {{#canact}}
                    <a class="btn proctoring-overview-secondary" href="{{releaseurl}}">{{#str}}overallreport:markreviewed, quizaccess_proctoring{{/str}}</a>
                    <a class="btn proctoring-overview-danger" href="{{confirmurl}}"
                       data-confirmation="modal"
                       data-confirmation-type="delete"
                       data-confirmation-title-str='["overallreport:confirmtitle", "quizaccess_proctoring"]'
                       data-confirmation-content-str='["overallreport:confirmbody", "quizaccess_proctoring"]'
                       data-confirmation-yes-button-str='["overallreport:escalate", "quizaccess_proctoring"]'>{{#str}}overallreport:escalate, quizaccess_proctoring{{/str}}</a>
                    {{/canact}}
                </div>
            </div>
        </details>
        {{/rows}}

        {{#emptyqueue}}
        <div class="proctoring-overview-empty">
            <div class="proctoring-overview-emptytitle">{{#str}}overallreport:queueclear, quizaccess_proctoring{{/str}}</div>
            <div class="proctoring-overview-emptybody">{{#str}}overallreport:queueclearbody, quizaccess_proctoring{{/str}}</div>
        </div>
        {{/emptyqueue}}

        {{^hasrows}}
        {{^emptyqueue}}
        <div class="proctoring-overview-empty">
            <div class="proctoring-overview-emptybody">{{#str}}overallreport:empty, quizaccess_proctoring{{/str}}</div>
        </div>
        {{/emptyqueue}}
        {{/hasrows}}
    </div>

    {{#hasrows}}{{{pagingbar}}}{{/hasrows}}
</div>
