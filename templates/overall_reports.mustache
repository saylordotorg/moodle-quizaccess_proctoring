{{!
    @template quizaccess_proctoring/overall_reports
    Site-wide aggregate proctoring report ("Exam integrity review").
    Example context (json):
    {
        "formurl": "https://example.com/overall_reports.php",
        "intro": "Proctored exam attempts from all courses on this site.",
        "minviolations": 0,
        "search": "", "tifirst": "", "tilast": "",
        "firstinitialbar": "<div class=\"initialbar\"></div>", "lastinitialbar": "<div class=\"initialbar\"></div>",
        "hasstudentfilter": false, "clearstudentfilterurl": "#",
        "courseoptions": [{"value": 0, "label": "All courses", "selected": true}],
        "rangeoptions": [{"value": "7days", "label": "Last 7 days", "selected": true}],
        "sortoptions": [{"value": "recent", "label": "Most recent activity", "selected": true}],
        "risklevoptions": [{"value": "", "label": "Any risk level", "selected": true}],
        "riskmin": 0, "riskmax": 100, "riskmaxbound": 100,
        "pulse": [{"num": 2, "label": "Withheld certificates", "hint": "Grade and certificate held, no decision yet", "url": "#", "iscritical": true, "isactive": true}],
        "views": [{"label": "Withheld certificates (2)", "url": "#", "isactive": true}],
        "flowheldnote": "The same withheld attempts are listed on the <a href=\"#\">Held certificates</a> tab.",
        "countnote": "Showing 2 of 12 attempts",
        "rows": [
            {
                "fullname": "John Doe", "email": "john.doe@example.com", "userurl": "#", "course": "CS105", "quiz": "Final exam",
                "violations": 7, "violationsbreakdown": "(5 events, 2 face mismatches)", "eventcountlabel": "7 detected events",
                "lastactivity": "1 January 2026  10:00 AM", "riskscore": 85, "risklevel": "Critical", "levelkey": "critical",
                "signalsummary": "AI tool (2) · Tab switching (5)", "statuslabel": "Certificate withheld", "reviewstate": "needs",
                "isneeds": true, "hassignals": true,
                "signals": [{"factor": "AI tool", "pts": "+30"}],
                "breakdown": [{"factor": "AI tool", "pts": "+30"}],
                "userid": 42, "profileurl": "#", "scorelabel": "17.00 / 20.00", "duration": "42 mins 6 secs",
                "accountage": "2 years 145 days", "accountcreated": "14 March 2024  9:02 AM", "attempturl": "#",
                "canact": true, "releaseurl": "#", "confirmurl": "#", "viewurl": "#",
                "cansignoff": false, "signoffurl": "", "undosignoffurl": "", "signofflabel": ""
            }
        ],
        "hasrows": true, "emptyqueue": false, "pagingbar": "<nav></nav>",
        "emptytitle": "Queue is clear", "emptybody": "Every held attempt has been reviewed.",
        "emptyisnotice": false, "emptyactionurl": "", "emptyactionlabel": "Open the risk review settings"
    }
}}

<div class="proctoring-overview">
    <p class="proctoring-overview-intro">{{intro}}</p>

    {{! Filters: student search + course + period + sort + minimum detected events. }}
    <form method="get" action="{{formurl}}" class="proctoring-overview-filters">
        <input type="hidden" name="queue" value="{{queue}}">
        <input type="hidden" name="tifirst" value="{{tifirst}}">
        <input type="hidden" name="tilast" value="{{tilast}}">
        <label class="proctoring-overview-filter is-search">
            <span>{{#str}}overallreport:filtersearch, quizaccess_proctoring{{/str}}</span>
            <input type="text" name="search" value="{{search}}"
                   placeholder="{{#str}}overallreport:filtersearchplaceholder, quizaccess_proctoring{{/str}}">
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filtercourse, quizaccess_proctoring{{/str}}</span>
            <select name="courseid">
                {{#courseoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/courseoptions}}
            </select>
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filterrange, quizaccess_proctoring{{/str}}</span>
            <select name="range">
                {{#rangeoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/rangeoptions}}
            </select>
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filtersort, quizaccess_proctoring{{/str}}</span>
            <select name="sort">
                {{#sortoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/sortoptions}}
            </select>
        </label>
        <label class="proctoring-overview-filter">
            <span>{{#str}}overallreport:filterrisklevel, quizaccess_proctoring{{/str}}</span>
            <select name="risklevel">
                {{#risklevoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/risklevoptions}}
            </select>
        </label>
        {{! Two inputs, so this one is a labelled group rather than a label: a label may only own
            one control, and pointing one at two of them leaves it ambiguous which it activates.
            Each input keeps its own aria-label, so both are named on their own. }}
        <div class="proctoring-overview-filter is-range" role="group"
             aria-labelledby="proctoring-riskrange-{{uniqid}}">
            <span id="proctoring-riskrange-{{uniqid}}">{{#str}}overallreport:filterriskrange, quizaccess_proctoring{{/str}}</span>
            <span class="proctoring-overview-rangeinputs">
                <input type="number" min="0" max="{{riskmaxbound}}" name="riskmin" value="{{riskmin}}"
                       aria-label="{{#str}}overallreport:filterriskmin, quizaccess_proctoring{{/str}}">
                <span class="proctoring-overview-rangedash">-</span>
                <input type="number" min="0" max="{{riskmaxbound}}" name="riskmax" value="{{riskmax}}"
                       aria-label="{{#str}}overallreport:filterriskmax, quizaccess_proctoring{{/str}}">
            </span>
        </div>
        {{! The count this filters on is not obvious from its name, and two of its behaviours
            surprise people often enough to be worth writing down next to the input. }}
        <label class="proctoring-overview-filter">
            <span title="{{#str}}overallreport:filterminviolations_help, quizaccess_proctoring{{/str}}">{{#str}}overallreport:filterminviolations, quizaccess_proctoring{{/str}}</span>
            <input type="number" min="0" name="minviolations" value="{{minviolations}}"
                   aria-describedby="proctoring-minviolations-help-{{uniqid}}">
            <small class="proctoring-overview-filterhelp" id="proctoring-minviolations-help-{{uniqid}}">{{#str}}overallreport:filterminviolations_hint, quizaccess_proctoring{{/str}}</small>
        </label>
        <button type="submit" class="btn btn-secondary proctoring-overview-apply">{{#str}}overallreport:apply, quizaccess_proctoring{{/str}}</button>
        {{#hasstudentfilter}}
        <a class="proctoring-overview-clearfilter" href="{{clearstudentfilterurl}}">{{#str}}overallreport:clearstudentfilter, quizaccess_proctoring{{/str}}</a>
        {{/hasstudentfilter}}
    </form>

    {{! Standard Moodle initials bars, filtering the list by first name and surname. }}
    <div class="proctoring-overview-initials">
        {{{firstinitialbar}}}
        {{{lastinitialbar}}}
    </div>

    {{! Pulse cards. }}
    <div class="proctoring-overview-pulse">
        {{#pulse}}
        <a class="proctoring-overview-pulsecard {{#isactive}}is-active{{/isactive}}" href="{{url}}">
            <div class="proctoring-overview-pulsenum {{#iscritical}}is-critical{{/iscritical}}">{{num}}</div>
            <div class="proctoring-overview-pulselabel">{{label}}</div>
            <div class="proctoring-overview-pulsehint">{{hint}}</div>
        </a>
        {{/pulse}}
    </div>

    {{! What the buckets mean and what a reviewer is expected to do with each one. Collapsed, so it
        answers the question without taking space from the queue once the answer is known. }}
    <details class="proctoring-overview-flow">
        <summary>{{#str}}overallreport:flowtitle, quizaccess_proctoring{{/str}}</summary>
        <div class="proctoring-overview-flowbody">
            <p>{{#str}}overallreport:flowintro, quizaccess_proctoring{{/str}}</p>
            <ul>
                <li>{{#str}}overallreport:flow_flagged, quizaccess_proctoring{{/str}}</li>
                <li>{{#str}}overallreport:flow_needs, quizaccess_proctoring{{/str}}</li>
                <li>{{#str}}overallreport:flow_escalated, quizaccess_proctoring{{/str}}</li>
                <li>{{#str}}overallreport:flow_reviewed, quizaccess_proctoring{{/str}}</li>
                <li>{{#str}}overallreport:flow_clean, quizaccess_proctoring{{/str}}</li>
            </ul>
            <p>{{{flowheldnote}}}</p>
        </div>
    </details>

    {{! View pills. }}
    <div class="proctoring-overview-views">
        {{#views}}
        <a class="proctoring-overview-pill {{#isactive}}is-active{{/isactive}}" href="{{url}}">{{label}}</a>
        {{/views}}
        <span class="proctoring-overview-countnote">{{countnote}}</span>
    </div>

    {{#truncated}}<div class="alert alert-warning">{{truncatednotice}}</div>{{/truncated}}

    {{! One row per attempt, in columns. The score breakdown stays reachable through a
        disclosure inside its own cell, so no row needs a separate "Details" affordance. }}
    <div class="proctoring-overview-tablewrap">
        <table class="proctoring-overview-table generaltable">
            <thead>
                <tr>
                    <th scope="col">{{#str}}overallreport:col_risk, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_student, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_moodleid, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_course, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_quiz, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_score, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_duration, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_accountage, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_signals, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_lastactivity, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_status, quizaccess_proctoring{{/str}}</th>
                    <th scope="col">{{#str}}overallreport:col_actions, quizaccess_proctoring{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr class="{{#isneeds}}is-needs{{/isneeds}} {{#isclean}}is-clean{{/isclean}}">
                    <td class="proctoring-overview-cell-risk">
                        <span class="proctoring-overview-score proctoring-risk-{{levelkey}}">
                            <span class="proctoring-overview-scorenum">{{riskscore}}</span>
                            <span class="proctoring-overview-scoreband">{{risklevel}}</span>
                        </span>
                    </td>
                    <td class="proctoring-overview-cell-student">
                        <a class="proctoring-overview-student" href="{{profileurl}}">{{fullname}}</a>
                        <span class="proctoring-overview-email">{{email}}</span>
                    </td>
                    <td><a href="{{profileurl}}">{{userid}}</a></td>
                    <td>{{course}}</td>
                    <td>{{quiz}}</td>
                    <td>{{scorelabel}}</td>
                    <td>{{duration}}</td>
                    <td title="{{accountcreated}}">{{accountage}}</td>
                    <td class="proctoring-overview-cell-signals">
                        <span class="proctoring-overview-eventcount" title="{{violationsbreakdown}}">{{eventcountlabel}}</span>
                        {{#hassignals}}
                        <details class="proctoring-overview-breakdowntoggle">
                            <summary>{{signalsummary}}</summary>
                            <div class="proctoring-overview-breakdown">
                                {{#breakdown}}
                                <div class="proctoring-overview-breakrow"><span>{{factor}}</span><span class="proctoring-overview-breakpts">{{pts}}</span></div>
                                {{/breakdown}}
                            </div>
                        </details>
                        {{/hassignals}}
                        {{^hassignals}}
                        <span class="proctoring-overview-signalrow"><span class="proctoring-overview-signaldot is-ok"></span>{{#str}}overallreport:nosignals, quizaccess_proctoring{{/str}}</span>
                        {{/hassignals}}
                    </td>
                    <td class="proctoring-overview-when">{{lastactivity}}</td>
                    <td>
                        <span class="proctoring-overview-status proctoring-overview-status-{{reviewstate}}">{{statuslabel}}</span>
                        {{#signofflabel}}<span class="proctoring-overview-signoff">{{signofflabel}}</span>{{/signofflabel}}
                    </td>
                    <td class="proctoring-overview-cell-actions">
                        <a href="{{viewurl}}">{{#str}}overallreport:openreport, quizaccess_proctoring{{/str}}</a>
                        {{#attempturl}}
                        <a href="{{attempturl}}">{{#str}}overallreport:openattempt, quizaccess_proctoring{{/str}}</a>
                        {{/attempturl}}
                        {{#cansignoff}}
                        <a href="{{signoffurl}}">{{#str}}overallreport:signoff, quizaccess_proctoring{{/str}}</a>
                        {{/cansignoff}}
                        {{#undosignoffurl}}
                        <a href="{{undosignoffurl}}">{{#str}}overallreport:undosignoff, quizaccess_proctoring{{/str}}</a>
                        {{/undosignoffurl}}
                        {{#canact}}
                        <a href="{{releaseurl}}">{{#str}}overallreport:markreviewed, quizaccess_proctoring{{/str}}</a>
                        <a class="proctoring-overview-dangerlink" href="{{confirmurl}}"
                           data-confirmation="modal"
                           data-confirmation-type="delete"
                           data-confirmation-title-str='["overallreport:confirmtitle", "quizaccess_proctoring"]'
                           data-confirmation-content-str='["overallreport:confirmbody", "quizaccess_proctoring"]'
                           data-confirmation-yes-button-str='["overallreport:escalate", "quizaccess_proctoring"]'>{{#str}}overallreport:escalate, quizaccess_proctoring{{/str}}</a>
                        {{/canact}}
                    </td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>

    {{#emptyqueue}}
        <div class="proctoring-overview-empty">
            <div class="proctoring-overview-emptytitle {{#emptyisnotice}}is-notice{{/emptyisnotice}}">{{emptytitle}}</div>
            <div class="proctoring-overview-emptybody">{{emptybody}}</div>
            {{#emptyactionurl}}
            <a class="proctoring-overview-emptyaction" href="{{emptyactionurl}}">{{emptyactionlabel}}</a>
            {{/emptyactionurl}}
        </div>
        {{/emptyqueue}}

        {{^hasrows}}
        {{^emptyqueue}}
        <div class="proctoring-overview-empty">
            <div class="proctoring-overview-emptybody">{{#str}}overallreport:empty, quizaccess_proctoring{{/str}}</div>
        </div>
        {{/emptyqueue}}
        {{/hasrows}}

    {{#hasrows}}{{{pagingbar}}}{{/hasrows}}
</div>
