{{!
    @template quizaccess_proctoring/report
    Example context (json):
    {
        "quizname": "Sample Quiz",
        "url": "https://example.com/search",
        "backbutton": "https://example.com/course/view.php?id=1",
        "courseid": "123",
        "cmid": "456",
        "searchkey": "example@example.com",
        "showclearbutton": true,
        "settingsbtn": true,
        "settingspageurl": "https://example.com/settings",
        "proctoringsummary": "Summary of proctoring details.",
        "searchplaceholder": "Search Placeholder Text",
        "searchbuttontext": "Search Button Text",
        "clearbuttontext": "Clear Button Text",
        "checkrow": true,
        "rows": [
            {
                "userlink": "https://example.com/user/1",
                "fullname": "John Doe",
                "email": "john.doe@example.com",
                "timemodified": "1 January 2026  10:00 AM EST",
                "identitymismatch": "No",
                "eventwarning": true,
                "findinglabel": "4",
                "eventcountlabel": "from 187 suspicious events",
                "findingtitle": "4 scored findings, from 187 suspicious events recorded during the attempt.",
                "scorelabel": "17.00 / 20.00",
                "timetaken": "42 mins 6 secs",
                "accountage": "2 years 145 days",
                "accountcreated": "14 March 2024  9:02 AM EDT",
                "attempturl": "https://example.com/mod/quiz/review.php?attempt=9",
                "riskbadgeclass": "badge badge-warning",
                "riskscore": 70,
                "risklevel": "Medium",
                "riskholdstatus": "",
                "aireview": false,
                "actionmenu": "<a href=\"https://example.com/view\">View</a>"
            }
        ]
    }
}}

<div id="main" >
    <h2>{{quizname}}</h2>
   <div class="box generalbox adminerror p-y-1">
        {{proctoringsummary}}
   </div>
   <br>
   <div class="mb-3">
    <a href="{{backbutton}}" class="btn btn-secondary">{{#str}}back,quizaccess_proctoring{{/str}}</a>
</div>

       <div class="container-fluid mb-3 p-1 m-1">
        <div class="row d-flex justify-content-between align-items-start flex-wrap p-0">
            <div class="col-8 p-0">
                <form action="{{url}}" class="d-flex flex-wrap align-items-start p-0">
                    <input type="hidden" id="courseid" name="courseid" value="{{courseid}}">
                    <input type="hidden" id="cmid" name="cmid" value="{{cmid}}">
                    <input type="text"
                           class="form-control ml-2"
                           id="searchKey"
                           name="searchKey"
                           placeholder="{{searchplaceholder}}"
                           value="{{searchkey}}">

                    <button type="submit" class="btn btn-primary ml-2" name="submitType" value="Search">{{searchbuttontext}}</button>

                    {{#showclearbutton}}
                    <button type="submit" class="btn btn-secondary ml-2" name="submitType" value="Clear">{{clearbuttontext}}</button>
                    {{/showclearbutton}}
                </form>
            </div>

            <div class="col-md-auto mt-2 mt-md-0 text-md-end me-0 pe-0">
                {{#overridesbtn}}
                <a class="btn btn-secondary mr-2 me-2" href="{{overridesurl}}">{{#str}}override_managebutton,quizaccess_proctoring{{/str}}</a>
                {{/overridesbtn}}
                {{#settingsbtn}}
                <a class="btn btn-primary" href="{{settingspageurl}}">{{#str}}course_proctoring_summary,quizaccess_proctoring{{/str}}</a>
                {{/settingsbtn}}
            </div>
        </div>
    </div>

{{#showfilters}}
<div class="proctoring-initial-bars mb-2">
    <div class="proctoring-initial-bar d-flex flex-wrap align-items-center mb-1">
        <span class="mr-2 font-weight-bold">{{firstinitiallabel}}:</span>
        {{#firstinitialbar}}
            <a href="{{url}}" class="btn btn-sm {{#active}}btn-primary{{/active}}{{^active}}btn-link{{/active}} p-1">{{label}}</a>
        {{/firstinitialbar}}
    </div>
    <div class="proctoring-initial-bar d-flex flex-wrap align-items-center">
        <span class="mr-2 font-weight-bold">{{lastinitiallabel}}:</span>
        {{#lastinitialbar}}
            <a href="{{url}}" class="btn btn-sm {{#active}}btn-primary{{/active}}{{^active}}btn-link{{/active}} p-1">{{label}}</a>
        {{/lastinitialbar}}
    </div>
</div>
{{/showfilters}}

{{#checkrow}}
<table class="table">
<thead>
        <tr class="table-info">
            {{#showfilters}}
            {{! Surname and first name sort separately, the way the grade report does it: reviewers
                switch between the two to spot duplicate accounts. }}
            <th>
                <a href="{{sortheaders.lastname.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.lastname.label}}{{/str}}">
                    {{sortheaders.lastname.label}}{{#sortheaders.lastname.asc}} &#9650;{{/sortheaders.lastname.asc}}{{#sortheaders.lastname.desc}} &#9660;{{/sortheaders.lastname.desc}}
                </a>
                /
                <a href="{{sortheaders.firstname.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.firstname.label}}{{/str}}">
                    {{sortheaders.firstname.label}}{{#sortheaders.firstname.asc}} &#9650;{{/sortheaders.firstname.asc}}{{#sortheaders.firstname.desc}} &#9660;{{/sortheaders.firstname.desc}}
                </a>
            </th>
            <th>
                <a href="{{sortheaders.email.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.email.label}}{{/str}}">
                    {{sortheaders.email.label}}{{#sortheaders.email.asc}} &#9650;{{/sortheaders.email.asc}}{{#sortheaders.email.desc}} &#9660;{{/sortheaders.email.desc}}
                </a>
            </th>
            <th>
                <a href="{{sortheaders.date.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.date.label}}{{/str}}">
                    {{sortheaders.date.label}}{{#sortheaders.date.asc}} &#9650;{{/sortheaders.date.asc}}{{#sortheaders.date.desc}} &#9660;{{/sortheaders.date.desc}}
                </a>
            </th>
            <th>{{#str}}identity_mismatch_label,quizaccess_proctoring{{/str}}</th>
            <th>
                <a href="{{sortheaders.violations.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.violations.label}}{{/str}}">
                    {{sortheaders.violations.label}}{{#sortheaders.violations.asc}} &#9650;{{/sortheaders.violations.asc}}{{#sortheaders.violations.desc}} &#9660;{{/sortheaders.violations.desc}}
                </a>
            </th>
            <th>
                <a href="{{sortheaders.risk.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.risk.label}}{{/str}}">
                    {{sortheaders.risk.label}}{{#sortheaders.risk.asc}} &#9650;{{/sortheaders.risk.asc}}{{#sortheaders.risk.desc}} &#9660;{{/sortheaders.risk.desc}}
                </a>
            </th>
            <th>
                <a href="{{sortheaders.score.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.score.label}}{{/str}}">
                    {{sortheaders.score.label}}{{#sortheaders.score.asc}} &#9650;{{/sortheaders.score.asc}}{{#sortheaders.score.desc}} &#9660;{{/sortheaders.score.desc}}
                </a>
            </th>
            {{/showfilters}}
            {{^showfilters}}
            <th>{{#str}}user,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}email,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}dateverified,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}identity_mismatch_label,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}report:col_findings,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}riskscore,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}report:col_score,quizaccess_proctoring{{/str}}</th>
            {{/showfilters}}
            <th>{{#str}}riskscore:timetaken,quizaccess_proctoring{{/str}}</th>
            {{#showfilters}}
            <th>
                <a href="{{sortheaders.accountage.url}}" title="{{#str}}report_sort_by,quizaccess_proctoring,{{sortheaders.accountage.label}}{{/str}}">
                    {{sortheaders.accountage.label}}{{#sortheaders.accountage.asc}} &#9650;{{/sortheaders.accountage.asc}}{{#sortheaders.accountage.desc}} &#9660;{{/sortheaders.accountage.desc}}
                </a>
            </th>
            {{/showfilters}}
            {{^showfilters}}
            <th>{{#str}}report:col_accountage,quizaccess_proctoring{{/str}}</th>
            {{/showfilters}}
            <th>{{#str}}aireview:shorttitle,quizaccess_proctoring{{/str}}</th>
            <th>{{#str}}actions,quizaccess_proctoring{{/str}}</th>
        </tr>
    </thead>
<tbody>
{{#rows}}
    <tr>
        <td><a href="{{userlink}}" target="_blank">{{fullname}}</a></td>
        <td>{{email}}</td>
        <td>{{timemodified}}</td>
        <td>
            {{identitymismatch}}
        </td>
        {{! The scored findings lead, with the raw suspicious-event total behind them: a bare event
            total read as "724 suspicious activities" on an attempt with four findings. }}
        <td title="{{findingtitle}}">
            {{#eventwarning}}⚠️ {{/eventwarning}}{{findinglabel}}
            <div class="text-muted small">{{eventcountlabel}}</div>
        </td>
        <td>
            <span class="{{riskbadgeclass}}">{{riskscore}}/100 {{risklevel}}</span>
            {{#riskholdstatus}}
                <div class="proctoring-risk-hold-status {{#riskholdactive}}proctoring-risk-hold-active{{/riskholdactive}}">{{riskholdstatus}}</div>
            {{/riskholdstatus}}
        </td>
        <td>{{#scorelabel}}{{scorelabel}}{{/scorelabel}}{{^scorelabel}}<span class="text-muted">&mdash;</span>{{/scorelabel}}</td>
        <td>
            {{#timetaken}}{{timetaken}}{{/timetaken}}{{^timetaken}}<span class="text-muted">&mdash;</span>{{/timetaken}}
        </td>
        <td title="{{accountcreated}}">{{#accountage}}{{accountage}}{{/accountage}}{{^accountage}}<span class="text-muted">&mdash;</span>{{/accountage}}</td>
        <td>
            {{#aireview}}
                {{#isfailed}}
                    <span class="proctoring-ai-toolfailure">{{toolfailurenotice}}</span>
                {{/isfailed}}
                {{^isfailed}}
                    <span class="proctoring-ai-review-list-status {{#isflagged}}proctoring-ai-review-list-flagged{{/isflagged}}">
                        {{compactlabel}}
                    </span>
                {{/isfailed}}
                <div class="proctoring-ai-review-meta">{{providerlabel}}</div>
            {{/aireview}}
            {{^aireview}}
                <span class="text-muted">{{#str}}aireview:notqueued,quizaccess_proctoring{{/str}}</span>
            {{/aireview}}
        </td>
        <td>
            {{{actionmenu}}}
            {{#attempturl}}
            <a class="btn btn-link btn-sm p-0 d-block" href="{{attempturl}}">{{#str}}report:col_attemptlink,quizaccess_proctoring{{/str}}</a>
            {{/attempturl}}
        </td>
    </tr>
{{/rows}}
</tbody>
</table>
{{/checkrow}}

{{^checkrow}}
<div class="alert alert-info text-center" role="alert">
   {{#str}}examdata,quizaccess_proctoring{{/str}}
</div>
{{/checkrow}}
</div>
